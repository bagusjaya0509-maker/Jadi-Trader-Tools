app.post('/api/akses/setelan', batasLaju, requireToken, (req, res) => {
  const b = req.body || {};
  const d = lisensiBaca();
  const st = d.setelan || (d.setelan = {});
  if (typeof b.bukaPermintaan === 'boolean') st.bukaPermintaan = b.bukaPermintaan;
  /* Batas atas 100000 bukan kesopanan: angka raksasa membuat bilah kuota di
     layar jadi garis rata yang tidak memberi tahu apa pun. */
  if (Number.isFinite(Number(b.gratisTotal))) st.gratisTotal = Math.min(100000, Math.max(0, Math.floor(Number(b.gratisTotal))));
  if (Number.isFinite(Number(b.bayarTotal)))  st.bayarTotal  = Math.min(100000, Math.max(0, Math.floor(Number(b.bayarTotal))));
  if (Number.isFinite(Number(b.hari)))        st.hari        = Math.min(3650, Math.max(1, Math.floor(Number(b.hari))));
  /* Harga: dua desimal, tidak negatif, atap 100000. Atapnya bukan
     kesopanan — halaman harga adalah tempat salah ketik berubah jadi
     penawaran resmi, dan nol tambahan di sana mahal. */
  ['hargaTesting', 'hargaTestingCoret', 'hargaPremium3', 'hargaTahunan', 'nilaiMarketplace', 'kursUsd'].forEach(function (k) {
    if (Number.isFinite(Number(b[k]))) st[k] = Math.min(100000, Math.max(0, Math.round(Number(b[k]) * 100) / 100));
  });
  if (typeof b.eventGratis === 'boolean') st.eventGratis = b.eventGratis;
  /* Hanya dua nilai yang dikenal. Nilai lain DIABAIKAN diam-diam, bukan
     disimpan apa adanya: yang tersimpan di sini akan dipakai memilih
     komponen di peramban orang lain. */
  if (b.tampilanAkses === 'foto' || b.tampilanAkses === 'lonceng') st.tampilanAkses = b.tampilanAkses;
  /* Tautan checkout. WAJIB https:// — nilai ini menjadi href di halaman
     depan, dan menerima untai bebas berarti menerima "javascript:..." yang
     dijalankan di peramban pengunjung. Untai kosong sah, artinya paketnya
     dinyatakan belum tersedia. */
  ['linkTesting', 'linkPremium3', 'linkTahunan'].forEach(function (k) {
    if (typeof b[k] !== 'string') return;
    const v = b[k].trim();
    if (v === '') { st[k] = ''; return; }
    if (!/^https:\/\/[^\s]{3,480}$/.test(v)) return;   // diam-diam ditolak, nilai lama dipertahankan
    st[k] = v;
  });
  lisensiTulis(d);
  res.json({ ok: true, ...bacaSetelan(d), ...hitungKuota(d) });
});

