/* ── BATAL UNTUK AGEN ────────────────────────────────────────────────────
   Pasangan bertoken dari /api/analisa/batal. Yang itu dijaga butuhLogin dan
   mensyaratkan a.uid === req.uid, dan agen tidak punya sesi login — jadi
   sampai rute ini ada, agen bisa memposting order menunggu tapi tidak bisa
   pernah menariknya.

   KENAPA ITU PENTING, bukan sekadar kerapian. Agen momentum memposting stop
   order di ujung candle; sebagian tidak pernah tertembus. Tanpa jalur batal
   ia menumpuk selamanya sebagai kartu "menunggu harga" yang tidak akan
   pernah selesai — dan lebih buruk, order yang baru tersentuh berhari-hari
   kemudian dihitung sebagai trade, padahal aturan yang diuji membatalkannya
   sesudah tiga bar. Papan peringkatnya akan menilai sistem yang BERBEDA
   dari yang diukur.

   PENJAGANYA SAMA PERSIS dengan rute manusia, dan itu disengaja: sudah
   selesai tidak bisa dibatalkan, YANG SUDAH TERISI tidak bisa dibatalkan,
   dan Market tidak bisa dibatalkan. Agen tidak boleh punya jalan keluar yang
   tidak dimiliki analis manusia — menarik order yang harganya sudah datang
   sama dengan menghapus trade yang sedang rugi, dan rekam jejak yang
   membolehkan itu tidak berarti apa-apa. */
app.post('/api/analisa/agen/batal', batasLaju, requireToken, (req, res) => {
  const id = String((req.body || {}).id || '');
  const alasan = String((req.body || {}).alasan || '').trim();
  if (alasan.length < 10) return res.status(400).json({ error: 'Alasan pembatalan wajib, minimal 10 huruf.' });

  const d = analisaBaca();
  const a = d.daftar.find((x) => x.id === id);
  if (!a) return res.status(404).json({ error: 'Sinyal tidak ada.' });
  if (!a.agen) return res.status(403).json({ error: 'Bukan analisa agen.' });
  if (a.hasil) return res.status(400).json({ error: 'Sinyal ini sudah selesai.' });
  if (a.terisi) return res.status(400).json({ error: 'Harga sudah menyentuh entry — sudah jalan.' });
  if (/^market$/i.test(String(a.jenisEntry || ''))) {
    return res.status(400).json({ error: 'Sinyal Market bukan order menunggu.' });
  }

  a.hasil = 'batal';
  a.waktuHasil = Date.now();
  a.alasanBatal = alasan.slice(0, 300);
  analisaTulis(d);
  res.json({ ok: true, hasil: 'batal' });
});

