app.post('/api/analisa/gambar/hapus', batasLaju, butuhLogin, (req, res) => {
  const { id, gambarId } = req.body || {};
  const d = analisaBaca();
  const a = d.daftar.find(x => x.id === String(id || ''));
  if (!a) return res.status(404).json({ error: 'Analisa tidak ditemukan' });
  const g = (a.galeri || []).find(x => x.id === String(gambarId || ''));
  if (!g) return res.status(404).json({ error: 'Foto tidak ditemukan' });
  // Pemilik ikut boleh menghapus, dan itu bukan kekuasaan berlebih: Pakta
  // Integritas PSE yang ditandatangani mewajibkan penyelenggara MENGAWASI
  // muatan yang tayang di sistemnya. Foto yang diunggah pengguna adalah
  // muatan itu, dan kewajiban mengawasi tanpa alat menghapus cuma janji.
  if (g.uid !== req.uid && a.uid !== req.uid && req.uid !== OWNER_UID) {
    return res.status(403).json({ error: 'Hanya pengunggah, penulis analisa, atau pengelola yang boleh menghapus' });
  }
  a.galeri = a.galeri.filter(x => x.id !== g.id);
  analisaTulis(d);
  // Berkasnya ikut dihapus; galeri yang menunjuk berkas hantu lebih buruk
  // daripada berkas yatim, tapi keduanya tidak perlu ada.
  if (g.berkas) { try { fs.unlinkSync(path.join(GAMBAR_DIR, g.berkas)); } catch (e) {} }
  res.json({ ok: true });
});

