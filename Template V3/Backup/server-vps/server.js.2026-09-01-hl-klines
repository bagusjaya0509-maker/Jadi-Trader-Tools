   ════════════════════════════════════════════════════════════════════ */
/* ════════════════════════════════════════════════════════════════════
   PROFIL PENGGUNA — foto & banner, milik masing-masing orang
   ════════════════════════════════════════════════════════════════════
   BERKAS TERPISAH dari profil-analis.json, dan itu keputusan privasi,
   bukan kerapian. GET /api/analis/profil memulangkan SELURUH peta
   uid -> {nama, foto} tanpa login sama sekali -- memang begitu tugasnya,
   papan peringkat dan daftar analisa perlu membaca nama orang yang
   memposting sinyal. Kalau foto tiap pengguna biasa ikut ditulis ke sana,
   nama dan wajah orang yang tidak pernah memposting apa pun jadi bisa
   diambil siapa saja yang membuka satu URL. Itu kebocoran, bukan fitur.

   Di sini kebalikannya: yang boleh membaca cuma pemilik datanya sendiri.

   GAMBARNYA tetap di GAMBAR_DIR yang sama dan disajikan dari /gambar --
   folder itu memang publik, dan itu tidak apa-apa: nama berkasnya
   mengandung potongan uid + stempel waktu base36, jadi ia tidak bisa
   ditebak dari daftar pengguna. Yang dijaga adalah PETANYA (siapa punya
   foto yang mana), bukan bytes gambarnya.
   ════════════════════════════════════════════════════════════════════ */
const PROFIL_USER_FILE = path.join(__dirname, 'profil-pengguna.json');
function profilUserBaca() {
  try { return JSON.parse(fs.readFileSync(PROFIL_USER_FILE, 'utf8')); } catch (e) { return {}; }
}
function profilUserTulis(d) {
  const sementara = PROFIL_USER_FILE + '.tmp';
  fs.writeFileSync(sementara, JSON.stringify(d, null, 2));
  fs.renameSync(sementara, PROFIL_USER_FILE);
}

app.get('/api/profil', batasLaju, butuhLogin, (req, res) => {
  const r = profilUserBaca()[req.uid] || {};
  res.json({ ok: true, foto: r.foto || '', banner: r.banner || '' });
});

/* Satu rute untuk dua gambar. Yang membedakan cuma medan `jenis`, dan
   tiap jenis punya medan berkasnya SENDIRI (berkasFoto / berkasBanner).
   Memakai satu medan `berkas` bersama akan membuat penyimpanan banner
   menghapus berkas avatar dari disk, karena cabang hapus-yang-lama
   membaca medan yang sama. */
app.post('/api/profil', batasLaju, butuhLogin, express.json({ limit: '8mb' }), (req, res) => {
  const { jenis, dataUrl, hapus } = req.body || {};
  if (jenis !== 'foto' && jenis !== 'banner') {
    return res.status(400).json({ error: "jenis harus 'foto' atau 'banner'" });
  }
  const p = profilUserBaca();
  const r = p[req.uid] || {};
  const medanBerkas = jenis === 'foto' ? 'berkasFoto' : 'berkasBanner';

  if (hapus === true) {
    if (r[medanBerkas]) {
      try { fs.unlinkSync(path.join(GAMBAR_DIR, r[medanBerkas])); } catch (e) {}
    }
    delete r[medanBerkas];
    delete r[jenis];
    r.diubah = Date.now();
    p[req.uid] = r;
    profilUserTulis(p);
    if (jenis === 'foto') {
      const pa = profilBaca();
      if (pa[req.uid] && pa[req.uid].berkas) {
        /* Berkasnya sudah dihapus dari disk di atas; yang tersisa cuma
           penunjuk yang menggantung. Modenya dikembalikan ke 'anonim'
           supaya papan peringkat menggambar huruf, bukan kotak rusak. */
        delete pa[req.uid].berkas;
        delete pa[req.uid].foto;
        pa[req.uid].avatar = 'anonim';
        profilTulis(pa);
      }
    }
    return res.json({ ok: true, foto: r.foto || '', banner: r.banner || '' });
  }

  if (typeof dataUrl !== 'string' || !dataUrl) {
    return res.status(400).json({ error: 'dataUrl kosong' });
  }
  const m = dataUrl.match(/^data:(image[/](?:png|jpeg|webp));base64,(.+)$/);
  if (!m) return res.status(400).json({ error: 'Format gambar tidak dikenali (harus PNG/JPG/WebP)' });
  const buf = Buffer.from(m[2], 'base64');
  if (buf.length > 2 * 1024 * 1024) {
    return res.status(413).json({ error: 'Gambar ' + (buf.length / 1048576).toFixed(1) + ' MB, batasnya 2 MB' });
  }
  const ext = { 'image/png': '.png', 'image/jpeg': '.jpg', 'image/webp': '.webp' }[m[1]];
  const berkas = jenis + '-' + req.uid.slice(0, 12) + '-' + Date.now().toString(36) + ext;
  try { fs.writeFileSync(path.join(GAMBAR_DIR, berkas), buf); }
  catch (e) { return res.status(500).json({ error: 'Gagal menyimpan: ' + e.message }); }
  /* Yang lama dihapus SESUDAH yang baru berhasil ditulis. Kalau
     penulisannya gagal, orangnya tetap punya gambar yang lama. */
  if (r[medanBerkas] && r[medanBerkas] !== berkas) {
    try { fs.unlinkSync(path.join(GAMBAR_DIR, r[medanBerkas])); } catch (e) {}
  }
  r[medanBerkas] = berkas;
  r[jenis] = (req.headers['x-forwarded-proto'] || 'https') + '://' + req.headers.host + '/gambar/' + berkas;
  r.diubah = Date.now();
  p[req.uid] = r;
  profilUserTulis(p);

  /* FOTO ikut disalin ke identitas analis -- TAPI hanya kalau orangnya
     sudah punya rekaman analis.
     ────────────────────────────────────────────────────────────────────
     Ini menyelesaikan dua hal yang tarik-menarik. Kalau tidak disalin,
     seorang analis yang mengganti fotonya di panel profil akan melihat
     wajah lamanya tetap terpampang di kartu sinyal dan papan peringkat --
     satu orang, dua foto, tanpa penjelasan. Kalau disalin tanpa syarat,
     foto SEMUA pengguna masuk ke peta yang dipulangkan
     GET /api/analis/profil tanpa login, dan orang yang tidak pernah
     memposting apa pun ikut terdaftar di sana.

     Syaratnya menutup keduanya: yang sudah punya identitas publik tetap
     punya satu wajah, yang belum tidak diseret ke daftar publik.

     Banner TIDAK ikut -- ia tidak punya tempat di kartu sinyal. */
  if (jenis === 'foto') {
    const pa = profilBaca();
    if (pa[req.uid]) {
      pa[req.uid].foto = r.foto;
      pa[req.uid].berkas = berkas;
      pa[req.uid].avatar = 'foto';
      profilTulis(pa);
    }
  }

  res.json({ ok: true, foto: r.foto || '', banner: r.banner || '' });
});

const PROFIL_FILE = path.join(__dirname, 'profil-analis.json');
function profilBaca() {
  try { return JSON.parse(fs.readFileSync(PROFIL_FILE, 'utf8')); } catch (e) { return {}; }
}
function profilTulis(d) {
  const sementara = PROFIL_FILE + '.tmp';
  fs.writeFileSync(sementara, JSON.stringify(d, null, 2));
