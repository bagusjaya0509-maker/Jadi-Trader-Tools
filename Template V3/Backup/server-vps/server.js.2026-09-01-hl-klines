// AKAR MENYAJIKAN V3 — untuk domain sendiri
// ══════════════════════════════════════════════════════════════════════
// Sebelum ini GET / menjawab 404 "Cannot GET /". Di alamat sslip.io itu
// tidak terasa karena tidak ada yang mengetiknya tanpa /v3/. Di domain
// sungguhan, itu justru yang PERTAMA diketik orang — dan halaman error
// adalah kesan pertama yang paling mahal.
//
// Ditaruh DI SINI, sesudah seluruh rute /api, dan bukan di sebelah blok
// /v3 di atas. express.static memanggil next() kalau berkasnya tidak ada,
// jadi sebenarnya ia tidak akan menutupi rute API mana pun — tapi urutan
// yang bergantung pada "kebetulan tidak ada berkas bernama api" adalah
// urutan yang akan pecah begitu ada yang menaruh folder bernama api di
// hasil build. Sesudah semua rute, tidak ada yang perlu diandaikan.
//
// Jalur /v3/ TETAP hidup: tautan lama, GitHub Pages, dan bookmark orang
// tidak boleh mati hanya karena ada alamat yang lebih pendek.
//
// Aplikasinya SUDAH TIDAK memakai HashRouter (17 Agu 2026). Rutenya kini
// alamat sungguhan, jadi fallback SPA-nya ada di bawah — cari FALLBACK_SPA.
app.use(express.static(V3_DIR, {
  setHeaders: function (res, berkas) {
    if (/[\/]assets[\/]/.test(berkas)) {
      res.setHeader("Cache-Control", "public, max-age=31536000, immutable");
    } else {
      res.setHeader("Cache-Control", "no-cache");
    }
  }
}));

