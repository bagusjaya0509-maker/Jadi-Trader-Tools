}
/* Dipakai tiap kali nama/avatar dikirim ke luar. Satu fungsi, jadi daftar
   analisa dan papan peringkat tidak bisa menampilkan orang yang sama
   dengan dua nama berbeda. */
function profilPakai(p, uid, namaRekaman) {
  const r = (p || {})[uid] || {};
  return {
    nama: r.nama || namaRekaman || 'Analis',
    /* 'anonim' = jangan tampilkan foto walau ada. Fotonya sengaja TIDAK
       dihapus: orang yang kembali ke mode foto tidak perlu mengunggah
       ulang sesuatu yang tidak pernah salah. */
    foto: r.avatar === 'foto' ? (r.foto || '') : '',
  };
}

