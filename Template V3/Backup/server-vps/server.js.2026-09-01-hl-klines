/* Naik/turun paket TANPA membuat permintaan baru.
   ────────────────────────────────────────────────────────────────────────
   Satu-satunya cara pemilik memindahkan seseorang dari akses gratis ke
   berbayar (atau sebaliknya) sesudah permintaannya disetujui.

   KUOTA IKUT SENDIRI, tidak dihitung terpisah. hitungKuota() membaca
   `jenis` dari permintaannya, jadi mengubah satu huruf di sana langsung
   memindahkan satu slot: pemakaian gratis turun satu, pemakaian bayar naik
   satu. Penghitung tersendiri akan jadi angka kedua yang harus dijaga tetap
   sama dengan yang pertama -- dan dua angka yang harus sama adalah dua
   angka yang suatu hari berbeda.

   Baris di `aktif` ikut ditandai uid + paket + berakhir. Sebelum ini baris
   lisensi cuma menyimpan sidik perangkat, sehingga tabel PAKET (kuota
   screener, Copy Signal, marketplace) tidak pernah berlaku untuk siapa pun
   -- semua pelanggan dihitung 'gratis'. Untuk orang yang dinaikkan lewat
   rute ini, paketnya kini benar-benar berlaku. */
const PAKET_UPGRADE = {
  gratis:   { hari: AKSES_HARI, jenis: 'gratis' },
  testing:  { hari: 30,  jenis: 'bayar' },
  premium3: { hari: 90,  jenis: 'bayar' },
  tahunan:  { hari: 365, jenis: 'bayar' },
};

app.post('/api/lisensi/permintaan/paket', batasLaju, requireToken, async (req, res) => {
  const b = req.body || {};
  const id = String(b.id || '');
  const paket = String(b.paket || '');
  const aturan = PAKET_UPGRADE[paket];
  if (!aturan) {
    return res.status(400).json({ error: 'paket harus salah satu dari: ' + Object.keys(PAKET_UPGRADE).join(', ') });
  }

  const d = lisensiBaca();
  const item = lisensiPermintaan(d).find(x => x.id === id);
  if (!item) return res.status(404).json({ error: 'Permintaan tidak ada' });
  /* Hanya yang SUDAH disetujui. Menaikkan paket permintaan yang belum
     diputus akan membuat orang punya paket berbayar tanpa pernah punya
     akses -- dan panelnya akan menampilkan dua keadaan yang bertentangan. */
  if (item.status !== 'disetujui') {
    return res.status(400).json({ error: 'Setujui permintaannya dulu sebelum mengubah paket.' });
  }

  const sebelum = { jenis: item.jenis || 'gratis', paket: item.paket || '', berakhir: item.berakhir || 0 };
  item.jenis = aturan.jenis;
  item.paket = paket === 'gratis' ? '' : paket;
  /* Dihitung dari SEKARANG, bukan disambung ke sisa yang lama. Pemilik yang
     menaikkan paket biasanya baru saja menerima pembayaran, dan masa
     berlakunya dimulai dari pembayaran itu. */
  item.berakhir = Date.now() + aturan.hari * MS_HARI;
  item.paketDiubahPada = Date.now();

  const baris = (d.aktif || []).find(x => x.sidik && x.sidik === item.sidik);
  if (baris) {
    baris.uid = item.uid || baris.uid || '';
    baris.paket = paket === 'gratis' ? 'gratis' : paket;
    baris.berakhir = item.berakhir;
  }
  lisensiTulis(d);

  let firestoreOk = false;
  try {
    const admin = ambilAdmin();
    if (admin && item.uid) {
      await admin.firestore().collection('langganan').doc(item.uid).set({
        bayarSampai: admin.firestore.Timestamp.fromMillis(item.berakhir),
        jenisAkses: aturan.jenis,
        paket: paket === 'gratis' ? 'gratis' : paket,
        disetujuiPada: admin.firestore.Timestamp.now()
      }, { merge: true });
      firestoreOk = true;
    }
  } catch (e) {
    console.error('[paket] gagal tulis Firestore:', e && e.message);
  }

  res.json({
    ok: true, sebelum,
    sesudah: { jenis: item.jenis, paket: item.paket, berakhir: item.berakhir },
    firestoreOk, kuota: hitungKuota(d),
  });
});

app.post('/api/lisensi/permintaan/putuskan', batasLaju, requireToken, async (req, res) => {
  const b = req.body || {};
  const id = String(b.id || '');
  const tindakan = b.tindakan === 'tolak' ? 'tolak' : 'setujui';

  const d = lisensiBaca();
  const daftar = lisensiPermintaan(d);
  const item = daftar.find(x => x.id === id);
  if (!item) return res.status(404).json({ error: 'Permintaan tidak ada' });
  if (item.status !== 'baru') return res.json({ ok: true, sudahDiputus: item.status, kode: item.kode || '' });

  /* Pesan pemilik disimpan PADA PERMINTAANNYA, bukan cuma dikirim lewat
     surel. Surel bisa masuk spam, terhapus, atau dikirim ke alamat yang
     tidak pernah dibuka; halaman aksesnya selalu bisa dibuka lagi. Yang
     tersimpan di sini itulah yang dibaca /api/lisensi/minta/saya. */
  const pesan = String(b.pesan || '').trim().slice(0, 600);

  if (tindakan === 'tolak') {
    item.status = 'ditolak';
    item.pesan = pesan;
    item.diputusPada = Date.now();
    lisensiTulis(d);
    res.json({ ok: true, status: 'ditolak', pesan });

    /* Sesudah res.json dan tanpa await yang menahan jawaban, sama seperti
       jalur persetujuan: panel pemilik tidak boleh menunggu server surel,
       dan gagal kirim tidak boleh terlihat seperti gagal menolak. */
    kirimSuratKeputusan({
      email: item.email, nama: item.nama, keputusan: 'ditolak',
      pesan, produk: item.produk,
    }).catch((e) => console.error('[surel] tak terduga:', e && e.message));
    return;
  }

  /* Menyetujui = menerbitkan kode DAN mengaktifkannya dalam satu operasi.
     Kalau dipisah jadi dua langkah, ada keadaan di mana permintaannya sudah
     "disetujui" tapi lisensinya belum aktif — dan pembelinya menunggu
     sesuatu yang tidak akan datang. */
  const kode = String(b.kode || '').trim().toUpperCase() || buatKodeLisensi();
  if (!/^JT3-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}$/.test(kode)) {
    return res.status(400).json({ error: 'Format kode tidak valid' });
  }
  const sidik = sidikDari(kode);
  /* Baris lisensi aktif WAJIB membawa `uid`.
     ────────────────────────────────────────────────────────────────────
     Dulu ia cuma { sidik, produk, catatan, tgl }. Akibatnya lisensiUid()
     - yang mencari x.uid === uid - TIDAK PERNAH menemukan barisnya, dan
     ringkasPaket() jatuh ke cabang terakhir: 'gratis'. Jadi setiap pembeli
     berbayar dibaca sebagai pengguna gratis oleh /api/paket, dan Copy
     Signal terkunci untuk orang yang sudah membayarnya.

     Diam-diam pula: halaman Akses tetap berkata "Aktif" karena status itu
     dibaca dari Firestore langganan/{uid}, sumber yang berbeda. Dua sumber
     yang tidak sepakat, dan yang kalah adalah yang menentukan fitur.

     `paket` ikut ditulis di sini supaya /api/paket/set tidak jadi
     satu-satunya jalan mengisinya - rute itu sendiri butuh lisensiUid()
     yang sama, jadi tanpa uid ia juga selalu gagal 404. */
  let barisAktif = d.aktif.find(x => x.sidik === sidik);
  if (!barisAktif) {
    barisAktif = { sidik, tgl: Date.now() };
    d.aktif.push(barisAktif);
  }
  barisAktif.produk = item.produk;
  barisAktif.catatan = (item.email || item.nama || '').slice(0, 120);
  barisAktif.uid = item.uid || barisAktif.uid || '';
  barisAktif.jenis = item.jenis || 'gratis';
  /* Paket yang sudah dipasang tangan TIDAK ditimpa: pemilik yang menaikkan
     seseorang ke tahunan lalu menyetujui perpanjangannya tidak boleh
     mendapati orang itu turun lagi ke testing. */
  if (!barisAktif.paket) {
    barisAktif.paket = item.paket || (item.jenis === 'bayar' ? 'testing' : 'gratis');
  }
  item.status = 'disetujui';
  item.kode = kode;
  item.sidik = sidik;
  item.pesan = pesan;
  item.diputusPada = Date.now();
  /* Masa berlaku dihitung dari PERSETUJUAN, bukan dari permintaan. Orang
     yang menunggu tiga hari sampai kamu sempat menekan tombol tidak boleh
     kehilangan tiga hari dari jatahnya. */
  item.berakhir = Date.now() + AKSES_HARI * MS_HARI;
  /* Disalin SESUDAH dihitung. lisensiUid() menyaring baris yang sudah
     lewat masa berlakunya; tanpa stempel ini tidak ada yang pernah
     kedaluwarsa di sisi fitur. */
  barisAktif.berakhir = item.berakhir;
  lisensiTulis(d);

  /* Ditulis juga ke Firestore `langganan/{uid}.bayarSampai`, karena di situ
     aplikasi web membaca status akses (lihat auth.tsx). Tanpa langkah ini
     permintaannya berstatus "disetujui" di panel ini tapi orangnya tetap
     terkunci di luar — disetujui yang tidak membuka apa pun. */
  let firestoreOk = false;
  try {
    const admin = ambilAdmin();
    if (admin && item.uid) {
      await admin.firestore().collection('langganan').doc(item.uid).set({
        bayarSampai: admin.firestore.Timestamp.fromMillis(item.berakhir),
        jenisAkses: item.jenis || 'gratis',
        disetujuiPada: admin.firestore.Timestamp.now()
      }, { merge: true });
      firestoreOk = true;
    }
  } catch (e) {
    console.error('Gagal menulis langganan Firestore:', e.message);
  }
  res.json({ ok: true, status: 'disetujui', kode, sidik, berakhir: item.berakhir, firestoreOk });

  /* Surat pemberitahuan dikirim SESUDAH res.json, dan sengaja tanpa await
     yang menahan jawaban. Dua alasan:

     · Panel pemilik tidak boleh menunggu SMTP. Handshake ke mail server bisa
       makan beberapa detik, dan tombol "Setujui" yang menggantung membuat
       pemiliknya menekan dua kali — lalu bertanya kenapa ada dua entri.

     · Gagal kirim tidak boleh terlihat seperti gagal menyetujui. Aksesnya
       sudah sah begitu ditulis ke berkas dan Firestore di atas; email cuma
       kabar. Kalau mail server mati, yang hilang kabarnya, bukan haknya.

     kirimSuratPersetujuan sendiri tidak pernah melempar, tapi .catch tetap
     dipasang: janji tanpa penangkap adalah unhandledRejection, dan itu bisa
     menjatuhkan proses Node di konfigurasi tertentu. */
  kirimSuratPersetujuan({
    email: item.email,
    nama: item.nama,
    kode,
    berakhir: item.berakhir,
    jenis: item.jenis,
  }).catch((e) => console.error('[surel] tak terduga:', e && e.message));

  /* Surat kedua HANYA kalau pemilik menuliskan pesan. Surat persetujuan di
     atas membawa kode dan masa berlaku -- menyelipkan catatan bebas ke
     dalamnya berarti menyusun ulang surat yang sudah terbukti sampai. Tanpa
     pesan, tidak ada surat kedua sama sekali; dua surat identik untuk satu
     kejadian membuat orang mengira aksesnya diberikan dua kali. */
  if (pesan) {
    kirimSuratKeputusan({
      email: item.email, nama: item.nama, keputusan: 'disetujui',
      pesan, produk: item.produk,
    }).catch((e) => console.error('[surel] tak terduga:', e && e.message));
  }
});

