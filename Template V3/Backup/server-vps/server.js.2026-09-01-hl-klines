// index.html dibaca tiap permintaan, bukan disimpan di memori: berkasnya
// diganti tiap deploy, dan salinan lama di memori berisi nama potongan
// JavaScript yang sudah tidak ada — layar putih sampai backend di-restart.
// Berkasnya 7 kB dan sudah ada di cache berkas sistem operasi.
function halamanUntuk(jalur) {
  var html = fs.readFileSync(path.join(V3_DIR, "index.html"), "utf8");
  var alamat = "https://jaditrader.co.id" + (jalur === "/" ? "/" : jalur);

  // canonical SELALU ditulis ulang, bahkan untuk halaman yang tidak
  // terdaftar: yang salah bukan judulnya, melainkan pernyataan "saya ini
  // sebenarnya halaman depan".
  html = html.replace(/<link rel="canonical" href="[^"]*"\s*\/?>/,
                      '<link rel="canonical" href="' + alamat + '" />');
  html = html.replace(/<meta property="og:url" content="[^"]*"\s*\/?>/,
                      '<meta property="og:url" content="' + alamat + '" />');

  var k = KEPALA[jalur];
  if (!k) return html;

  html = html.replace(/<title>[^<]*<\/title>/, "<title>" + lolos(k.judul) + "</title>");
  html = html.replace(/<meta name="description" content="[^"]*"\s*\/?>/,
                      '<meta name="description" content="' + lolos(k.ket) + '" />');
  html = html.replace(/<meta property="og:title" content="[^"]*"\s*\/?>/,
                      '<meta property="og:title" content="' + lolos(k.judul) + '" />');
  html = html.replace(/<meta property="og:description" content="[^"]*"\s*\/?>/,
                      '<meta property="og:description" content="' + lolos(k.ket) + '" />');
  html = html.replace(/<meta name="twitter:title" content="[^"]*"\s*\/?>/,
                      '<meta name="twitter:title" content="' + lolos(k.judul) + '" />');
  html = html.replace(/<meta name="twitter:description" content="[^"]*"\s*\/?>/,
                      '<meta name="twitter:description" content="' + lolos(k.ket) + '" />');
  return html;
}

// Teksnya kita sendiri yang menulis, bukan masukan pengguna — tapi ia
// disisipkan ke dalam atribut HTML, dan satu tanda kutip yang lupa akan
// merusak kepala halaman tanpa pesan galat apa pun.
function lolos(t) {
  return String(t).replace(/&/g, "&amp;").replace(/</g, "&lt;")
                  .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}
