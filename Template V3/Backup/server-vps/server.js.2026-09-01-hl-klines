// MARKETPLACE — penyajian kode indikator berbayar
// ════════════════════════════════════════════════════════════════════════════
// Kenapa lewat backend, bukan file .txt di GitHub Pages:
// berkas di Pages punya URL publik yang gampang ditebak, jadi indikator $50
// bisa diambil siapa saja tanpa bayar - pagar harganya cuma hiasan. Di sini
// sumbernya TIDAK PERNAH ada di repo publik; ia hanya keluar kalau kode
// lisensi pembeli sudah diaktifkan pemilik, dan keluar sudah ber-watermark.
const fs = require('fs');
const path = require('path');

const PRODUK_DIR   = path.join(__dirname, 'produk');          // .txt sumber (jangan di-commit ke repo publik)
const LISENSI_FILE = path.join(__dirname, 'lisensi.json');

/* ── Kuota akses perintis ────────────────────────────────────────────────
   20 akses gratis dan 80 berbayar, masing-masing 30 hari. Angkanya di sini,
   BUKAN di frontend: penghitung yang hidup di browser bisa dibaca ulang
   dengan angka apa pun oleh siapa pun yang membuka DevTools, dan kuota yang
   bisa dikarang sendiri bukan kuota. */
const KUOTA_GRATIS = 20;
const KUOTA_BAYAR  = 80;
const AKSES_HARI   = 30;
const MS_HARI      = 86400000;

/* Setelan yang bisa diubah pemilik dari halaman Maintenance. Disimpan di
   lisensi.json bersama datanya, bukan di berkas terpisah: satu sumber, satu
   yang perlu dicadangkan. Nilai bawaan dipakai kalau belum pernah diatur. */
function bacaSetelan(d) {
  const st = d.setelan || {};
  return {
    /* Menutup pendaftaran TIDAK mencabut akses siapa pun yang sudah masuk —
       ia cuma menolak permintaan baru. Dua hal berbeda yang gampang
       tertukar, dan tertukarnya berarti mengunci orang yang sudah bayar. */
    bukaPermintaan: st.bukaPermintaan !== false,
    gratisTotal: Number.isFinite(st.gratisTotal) ? Math.max(0, st.gratisTotal) : KUOTA_GRATIS,
    bayarTotal: Number.isFinite(st.bayarTotal) ? Math.max(0, st.bayarTotal) : KUOTA_BAYAR,
    hari: Number.isFinite(st.hari) ? Math.max(1, st.hari) : AKSES_HARI,
    /* HARGA PAKET, dalam DOLAR. Tinggal di sini dan bukan di berkas
       tersendiri karena ini satu urusan yang sama: apa yang dijual, berapa
       harganya, dan berapa sisa tempatnya. Memisahnya berarti dua sumber
       kebenaran untuk satu halaman harga. */
    hargaTesting: Number.isFinite(st.hargaTesting) ? Math.max(0, st.hargaTesting) : 1,
    hargaTestingCoret: Number.isFinite(st.hargaTestingCoret) ? Math.max(0, st.hargaTestingCoret) : 5,
    hargaPremium3: Number.isFinite(st.hargaPremium3) ? Math.max(0, st.hargaPremium3) : 10,
    hargaTahunan: Number.isFinite(st.hargaTahunan) ? Math.max(0, st.hargaTahunan) : 79,
    /* Nilai daftar produk marketplace yang IKUT di paket tahunan. Dipakai
       menghitung klaim hematnya, jadi ia setelan — bukan angka yang ditulis
       tangan di kartu harga.

       Pada $100 paket tahunan justru LEBIH MAHAL daripada merakit sendiri
       (4 x paket 3 bulan + produk satuan), dan paket "paling hemat" yang
       kalah hitungan cuma menunggu satu pembaca teliti. Diturunkan ke 79
       supaya klaimnya benar. */
    nilaiMarketplace: Number.isFinite(st.nilaiMarketplace) ? Math.max(0, st.nilaiMarketplace) : 54,
    /* Kurs dolar ke rupiah untuk keterangan kecil di bawah harga.

       SETELAN, bukan kurs hidup dari API mana pun. Dua sebab. Pertama,
       halaman depan tidak boleh bergantung pada layanan luar untuk
       menggambar harga. Kedua dan lebih penting: angka rupiah ini nanti
       harus SAMA dengan yang benar-benar ditagih Xendit, dan tagihan itu
       ditentukan pemiliknya saat membuat produk — bukan oleh kurs pasar
       hari ini. Kurs yang bergerak sendiri justru membuat angka di halaman
       berbeda dengan angka di kuitansi. */
    kursUsd: Number.isFinite(st.kursUsd) ? Math.max(1, st.kursUsd) : 17000,
    /* Sakelar kartu event gratis. Kartunya juga hilang sendiri saat kuota
       gratis habis — sakelar ini untuk mematikannya SEBELUM habis. */
    eventGratis: st.eventGratis !== false,
    /* TAUTAN CHECKOUT per paket. Kosong berarti paketnya BELUM bisa dibeli,
       dan halaman depan menampilkannya sebagai "Available soon" dengan
       tombol mati — bukan tombol hidup yang mengantar ke tempat yang tidak
       menjualnya. Begitu tautannya diisi dari Maintenance, kartunya hidup
       sendiri tanpa perlu ganti kode. */
    /* Gambar apa yang dipasang di sisi kiri halaman akses. Setelan, bukan
       kode, karena yang ingin diubah pemiliknya adalah TAMPILAN untuk
       semua pengunjung -- dan tampilan yang cuma bisa diganti dengan
       menyunting kode lalu menunggu build berarti tidak bisa diganti
       sama sekali saat sedang ingin diganti.

       Daftar putih, bukan untai bebas. Nilai ini menentukan komponen mana
       yang dirender; menerima apa saja dari badan permintaan berarti
       menaruh keputusan render di tangan siapa pun yang punya token. */
    tampilanAkses: st.tampilanAkses === 'lonceng' ? 'lonceng' : 'foto',
    linkTesting: typeof st.linkTesting === 'string' ? st.linkTesting : '',
    linkPremium3: typeof st.linkPremium3 === 'string' ? st.linkPremium3 : '',
    linkTahunan: typeof st.linkTahunan === 'string' ? st.linkTahunan : '',
  };
}

function hitungKuota(d) {
  const disetujui = lisensiPermintaan(d).filter(x => x.status === 'disetujui');
  /* Permintaan lama belum punya field `jenis`. Dianggap gratis — itu memang
     asalnya, dan menghitungnya sebagai berbayar akan melaporkan pemasukan
     yang tidak pernah ada. */
  const gratis = disetujui.filter(x => x.jenis !== 'bayar').length;
  const bayar  = disetujui.filter(x => x.jenis === 'bayar').length;
  const st = bacaSetelan(d);
  return {
    gratisTerpakai: gratis, gratisTotal: st.gratisTotal,
    gratisSisa: Math.max(0, st.gratisTotal - gratis), gratisHabis: gratis >= st.gratisTotal,
    bayarTerpakai: bayar, bayarTotal: st.bayarTotal,
    bayarSisa: Math.max(0, st.bayarTotal - bayar), bayarHabis: bayar >= st.bayarTotal,
    hari: st.hari,
    bukaPermintaan: st.bukaPermintaan,
    /* Ikut di sini supaya halaman depan cukup SATU permintaan tanpa token.
       Tidak ada yang rahasia di harga jual — ia memang untuk dibaca orang
       yang belum punya akun sama sekali. */
    hargaTesting: st.hargaTesting,
    hargaTestingCoret: st.hargaTestingCoret,
    hargaPremium3: st.hargaPremium3,
    hargaTahunan: st.hargaTahunan,
    nilaiMarketplace: st.nilaiMarketplace,
    kursUsd: st.kursUsd,
    eventGratis: st.eventGratis,
    /* Ikut di jawaban PUBLIK karena halaman akses membacanya sebelum
       siapa pun masuk -- itu justru satu-satunya saat ia dibutuhkan. */
    tampilanAkses: st.tampilanAkses,
    linkTesting: st.linkTesting,
    linkPremium3: st.linkPremium3,
    linkTahunan: st.linkTahunan
  };
}

function lisensiBaca() {
  try { return JSON.parse(fs.readFileSync(LISENSI_FILE, 'utf8')); }
  catch (e) { return { aktif: [] }; }
}
function lisensiTulis(d) {
  fs.writeFileSync(LISENSI_FILE, JSON.stringify(d, null, 2));
}
function sidikDari(kode) {
  return crypto.createHash('sha256').update('sidik|' + kode).digest('hex').slice(0, 10);
}

// Penyisipan penanda — HARUS sama persis dengan versi di marketplace.html,
// supaya pelacak kebocoran di panel pemilik bisa membacanya kembali.
function sisipkanPenanda(sumber, kode) {
  const inti = kode.replace(/^JT3-/, '').replace(/-/g, '');
  const a = inti.substr(0, 4), b = inti.substr(4, 4), c = inti.substr(8, 4);
  const eol = sumber.indexOf('\r\n') >= 0 ? '\r\n' : '\n';
  const baris = sumber.split(/\r?\n/);
  const stempel = new Date().toISOString().slice(0, 10).replace(/-/g, '');

  let iVer = baris.findIndex(l => l.indexOf('//@version') === 0);
  if (iVer < 0) iVer = 0;
  baris.splice(iVer + 1, 0, '// build ' + stempel + '.' + a.toLowerCase() + ' — dist ' + b.toLowerCase());

  const iInd = baris.findIndex(l => l.indexOf('indicator(') >= 0);
  if (iInd >= 0) {
    baris.splice(iInd + 1, 0, '', '// revisi internal — jangan diubah', '_rev = "' + a + c + '"');
  }

  let tengah = Math.floor(baris.length * 0.55);
  for (let i = tengah; i < baris.length; i++) {
    if (baris[i].indexOf('// ═══') === 0) { tengah = i; break; }
  }
  baris.splice(tengah, 0, '// ref-' + b.toLowerCase() + c.toLowerCase() + ' (' + stempel + ')');

  baris.push('');
  baris.push('// ' + stempel + '-' + a.toLowerCase() + b.toLowerCase() + c.toLowerCase());
  return baris.join(eol);
}

