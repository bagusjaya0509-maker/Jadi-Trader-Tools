/* Tengah malam WIB 21 Agu 2026. Aturan baru TIDAK berlaku surut: sinyal
   yang sudah diposting dinilai dengan aturan yang berlaku saat ia
   diposting. Mengubah penilaian sesuatu yang sudah terjadi berarti
   memindahkan garis finis sesudah orang berlari. */
const SL_ATURAN_MULAI = Date.UTC(2026, 7, 20, 17, 0, 0);

/* Dipanggil dengan SINYALNYA, bukan tanpa argumen seperti dulu.
   Tiga jawaban:
   • Diposting sebelum aturan baru -> batas lama, apa adanya.
   • Timeframe diketahui           -> batas timeframe itu.
   • Timeframe TIDAK diketahui     -> Infinity, alias tidak dinilai.
     Bukan kelonggaran: sinyal yang tidak menyebut timeframe-nya tidak
     bisa diukur "melenceng dari rencana" tanpa menebak rencananya
     dulu, dan menuduh dengan angka tebakan lebih buruk daripada tidak
     menuduh. Formulir sekarang selalu mengirim tf; yang kosong cuma
     rekaman lama. */
function batasSl(a) {
  const dibuat = Number(a && a.dibuat) || 0;
  if (dibuat < SL_ATURAN_MULAI) return SL_MAKS_PERSEN;
  const tf = String((a && a.tf) || '').trim();
  if (!tf) return Infinity;
  const b = SL_MAKS_TF[tf];
  return typeof b === 'number' ? b : Infinity;
}
const MIN_SINYAL_PAPAN = 5;
/* Papan ini memajang orang untuk DITIRU. Analis yang sudah sebulan tidak
   menulis apa-apa tidak sedang menawarkan apa pun untuk ditiru, seberapa
   pun bagus angkanya bulan ini. 30 hari, bukan 7: syarat mingguan
