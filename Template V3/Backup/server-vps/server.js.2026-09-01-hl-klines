// COPY TRADING — analisa berbayar antar pengguna
// ═══════════════════════════════════════════════════════════════════════════
// Disimpan sebagai berkas JSON seperti lisensi & produk — bukan Firestore,
// karena backend ini tidak memegang kredensial admin Firestore, dan pola
// berkas+token sudah terbukti di rute lisensi. Pembayaran v1 manual: pembeli
// transfer -> kirim bukti -> ANALISNYA menyetujui -> isi terbuka. Gerbang
// pembayaran otomatis menyusul lewat halaman Billing.
const ANALISA_FILE = path.join(__dirname, 'analisa.json');
const ANALISA_CADANGAN = ANALISA_FILE + '.bak';
function analisaBaca() {
  try {
    const t = fs.readFileSync(ANALISA_FILE, 'utf8');
    const j = JSON.parse(t);
    if (!j || !Array.isArray(j.daftar)) throw new Error('bentuk tidak dikenali');
    return j;
  } catch (e) {
    // Berkas utama rusak/separuh. Cadangan dicoba SEBELUM menyerah — dan
    // kalau dua-duanya gagal, dilempar. Memulangkan daftar kosong di sini
    // adalah cara berkas ini kehilangan isinya: pemanggil menambah satu
    // item ke "daftar kosong" itu lalu menyimpannya sebagai kebenaran.
    console.error('[analisa] gagal membaca berkas utama:', e.message);
    const c = JSON.parse(fs.readFileSync(ANALISA_CADANGAN, 'utf8'));
    if (!c || !Array.isArray(c.daftar)) throw new Error('cadangan juga rusak');
    console.error('[analisa] dipulihkan dari cadangan:', c.daftar.length, 'item');
    return c;
  }
}
function analisaTulis(d) {
  if (!d || !Array.isArray(d.daftar)) throw new Error('menolak menulis bentuk yang tidak dikenali');
  const teks = JSON.stringify(d, null, 2);
  // Salinan LAMA disimpan dulu, baru yang baru ditulis. Urutannya penting:
  // cadangan yang dibuat sesudah penulisan cuma menyalin kerusakan.
  try { fs.copyFileSync(ANALISA_FILE, ANALISA_CADANGAN); } catch (e) {}
  // Tulis ke berkas sementara lalu rename. rename() atomik di filesystem
  // yang sama, jadi pembaca hanya pernah melihat versi lama ATAU versi
  // baru — tidak pernah setengahnya.
  const sementara = ANALISA_FILE + '.tmp';
  fs.writeFileSync(sementara, teks);
  fs.renameSync(sementara, ANALISA_FILE);
}

// ═══════════════════════════════════════════════════════════════════════════
// PENILAI ANALISA — apakah sinyalnya sudah kena SL atau TP
// ═══════════════════════════════════════════════════════════════════════════
// Label "Expired" di kartu Copy Signal harus lahir dari APA YANG BENAR-BENAR
// TERJADI, bukan dari perbandingan dengan harga sekarang. Sinyal yang sempat
// menyentuh TP lalu harganya balik lagi tetap sudah selesai — membandingkan
// harga saat ini akan menyatakannya masih aktif, dan orang yang membaca kartu
// itu menyangka masih ada peluang yang sebetulnya sudah lewat.
//
// Jadi yang diperiksa adalah SELURUH lilin sejak analisa diposting, berurutan:
//
//   1. Belum terisi  -> tunggu harga menyentuh entry.
//   2. Sudah terisi  -> mana yang tersentuh lebih dulu, SL atau TP.
//
// Kalau SATU lilin menyentuh SL dan TP sekaligus, urutannya TIDAK bisa
// diketahui dari data OHLC. Yang dicatat SL — bukan karena pesimis, tapi
// karena label yang salah ke arah "menang" membuat rekam jejak agen terlihat
// lebih baik daripada kenyataannya, dan itu jenis kesalahan yang paling
// merugikan orang yang mempercayainya.
//
// Simbol yang tidak bisa dinilai (MT5, saham, apa pun di luar Binance
// Futures) DIBIARKAN tanpa status. Kartunya tidak akan berlabel apa-apa,
// dan itu lebih jujur daripada menebak.

const https = require('https');

const NILAI_JEDA_MS = 60 * 1000;   // tiap menit — kartu 'Berjalan' padahal sudah kena SL adalah angka salah di papan peringkat
const NILAI_MAKS_HARI = 30;            // sinyal lebih tua dari ini berhenti dinilai

/** Lilin 1 menit sejak sebuah waktu — dipakai HANYA untuk menentukan jenis
 *  entry, tidak pernah untuk menilai hasil.
 *
 *  Ada karena penilai memakai lilin 15 menit, dan lilin 15 menit pertama
 *  sesudah sebuah sinyal baru terbit di batas seperempat jam berikutnya.
 *  Selama menunggu itu jenis entry tidak bisa ditentukan, dan tanpa jenis
 *  entry tombol Batalkan tidak muncul — analis yang baru memposting justru
 *  saat paling ingin bisa menarik ordernya, tidak bisa, sampai 15 menit.
 *
 *  Di jalur MT5 celah itu tidak ada: TF_NILAI_MT5 dimulai dari '1m', jadi
 *  lilin pertamanya terbit dalam hitungan detik. Ini menyamakan keduanya.
 *
 *  BUKAN untuk telusuri(). Penilaian hasil tetap memakai 15 menit dengan
 *  seluruh penjaganya — yang dijawab fungsi ini cuma satu angka: berapa
 *  harga pasar saat sinyalnya dibuat. */
function ambilKlines1m(simbol, mulaiMs) {
  return new Promise((res) => {
    const jalur = `/fapi/v1/klines?symbol=${simbol}&interval=1m&startTime=${Math.floor(mulaiMs / 60000) * 60000}&limit=5`;
    https.get('https://fapi.binance.com' + jalur, (r) => {
      let s = '';
      r.on('data', (d) => (s += d));
      r.on('end', () => {
        try {
          const j = JSON.parse(s);
          res(Array.isArray(j) ? j.filter((k) => Number(k[0]) >= mulaiMs) : null);
        } catch { res(null); }
      });
    }).on('error', () => res(null));
  });
}

function ambilKlines(simbol, mulaiMs) {
  return new Promise((res) => {
    // 15 menit: cukup halus untuk tahu urutan SL/TP pada sebagian besar
    // sinyal, cukup kasar untuk memuat 30 hari dalam satu permintaan.
    const LILIN_MS = 15 * 60 * 1000;
    const mulaiLilin = Math.floor(mulaiMs / LILIN_MS) * LILIN_MS;
    const jalur = `/fapi/v1/klines?symbol=${simbol}&interval=15m&startTime=${mulaiLilin}&limit=1500`;
    https.get('https://fapi.binance.com' + jalur, (r) => {
      let s = '';
      r.on('data', (d) => (s += d));
      r.on('end', () => {
        try {
          const j = JSON.parse(s);
          if (!Array.isArray(j)) return res(null);
          /* ── LILIN SEBELUM SINYALNYA DIPOSTING DIBUANG ──────────────────
             startTime dibulatkan TURUN ke batas lilin 15 menit, jadi lilin
             pertama yang dipulangkan Binance bisa dibuka sampai 15 menit
             SEBELUM sinyalnya ada. Penilai membaca lilin itu utuh —
             termasuk gerak harga yang sudah terjadi saat analisnya belum
             memposting apa pun.

             Terbukti di data sungguhan: BTCUSDT "BO M15" diposting
             17 Agu 10:23, tercatat entry tersentuh 10:15. Delapan menit
             sebelum sinyalnya ada.

             Yang membuat ini serius bukan sentuhannya, melainkan bahwa
             satu lilin 15 menit bisa memuat entry DAN TP sekaligus. Papan
             peringkat lalu mencatat kemenangan dari gerak harga yang sudah
             lewat sebelum sinyalnya diposting — kemenangan yang tidak
             mungkin diikuti siapa pun.

             Sekarang lilin yang dibuka sebelum waktu posting dibuang.
             Ongkosnya: gerak harga di SISA lilin pertama itu (0-15 menit
             sesudah posting) ikut hilang, jadi sentuhan yang cuma terjadi
             di situ baru terbaca kalau harganya kembali. Itu pertukaran
             yang sudah jadi sikap berkas ini: menunda penilaian jauh lebih
             baik daripada menerbitkan hasil yang salah.

             Jalur MT5 sudah begini sejak awal (lilinMt5Sejak memfilter
             k[0] >= sejak). Ini menyamakan keduanya — dan asimetri itulah
             yang membuat cacatnya cuma muncul di sinyal kripto. */
          res(j.filter((k) => Number(k[0]) >= mulaiMs));
        } catch (e) { res(null); }
      });
    }).on('error', () => res(null));
  });
}

/** Telusuri lilin berurutan. Memulangkan 'tp' | 'sl' | null (belum selesai). */
function telusuri(lilin, { arah, entry, sl, tp }) {
  let terisi = false;
  let waktuIsi = 0;
  for (const k of lilin) {
    const high = +k[2], low = +k[3];
    if (!terisi) {
      // Entry tersentuh kalau berada di dalam rentang lilin ini. Ini juga
      // menangkap entry MARKET dan entry yang dilewati karena gap.
      if (low <= entry && entry <= high) { terisi = true; waktuIsi = +k[0]; }
      else continue;
    }
    const kenaSl = arah === 'BUY' ? low <= sl : high >= sl;
    const kenaTp = arah === 'BUY' ? high >= tp : low <= tp;
    if (kenaSl) return { hasil: 'sl', waktu: +k[0], terisi, waktuIsi };  // didahulukan saat keduanya kena — lihat catatan di atas
    if (kenaTp) return { hasil: 'tp', waktu: +k[0], terisi, waktuIsi };
  }
  /* SELALU memulangkan objek, tidak pernah null. "Belum terisi" dan "terisi
     tapi belum kena SL/TP" adalah dua keadaan berbeda, dan yang memanggil
     butuh membedakannya — hanya yang pertama yang boleh dibatalkan. */
  return { hasil: null, waktu: 0, terisi, waktuIsi };
}

/** Jenis order dari letak entry terhadap harga sekarang. Dipakai kartu untuk
 *  memberi tahu "Buy Limit" / "Sell Stop" TANPA membuka angkanya — orang
 *  perlu tahu apakah ini rencana menunggu atau eksekusi sekarang sebelum
 *  memutuskan membayar. */
function jenisEntry(arah, entry, kini) {
  if (!kini || !entry) return '';
  const beda = Math.abs(entry - kini) / kini;
  if (beda < 0.0005) return 'Market';                       // dalam 0,05% = praktis harga sekarang
  if (arah === 'BUY') return entry < kini ? 'Buy Limit' : 'Buy Stop';
  return entry > kini ? 'Sell Limit' : 'Sell Stop';
}

/* Lilin MT5 sebuah simbol sejak waktu tertentu, atau null kalau tidak bisa
   dipertanggungjawabkan.

   ── KENAPA HARUS MENUTUPI SELURUH PERIODENYA ──────────────────────────
   EA menyimpan 3000 lilin per timeframe, jadi tiap timeframe punya jangkauan
   ke belakang yang berbeda: 1m cuma beberapa hari, 1d bertahun. Kalau sinyal
   diposting SEBELUM lilin paling awal yang kita punya, sebagian perjalanannya
   hilang — dan yang hilang itu justru bisa berisi sentuhan SL yang terjadi
   lebih dulu. Menilai dari potongan begitu akan melaporkan MENANG untuk
   trade yang sebenarnya sudah kalah.

   Karena itu timeframe hanya dipakai kalau lilin pertamanya <= waktu posting.
   Tidak ada yang memenuhi -> null, dan sinyalnya tetap "berjalan". Menunda
   penilaian jauh lebih baik daripada menerbitkan hasil yang salah di papan
   yang dipakai orang memilih siapa yang ditiru.

   ── DARI HALUS KE KASAR ───────────────────────────────────────────────
   Timeframe halus memberi urutan sentuhan yang lebih tepat saat SL dan TP
   kena di hari yang sama, jadi ia didahulukan; yang kasar cuma dipakai
   kalau yang halus tidak menjangkau cukup jauh ke belakang. */
const TF_NILAI_MT5 = ['1m', '5m', '15m', '30m', '1h', '4h', '1d'];

/* Ambil deret lilin dari SATU laci terminal. */
function lilinDariLaci(laci, pasangan, sejak) {
  if (!laci) return null;
  /* Nama di sinyal ditulis tanpa akhiran broker ("XAUUSD"), dan EA memang
     mengirimnya dalam bentuk dasar itu juga. Dicocokkan apa adanya dulu,
     baru tanpa akhiran huruf kecil sebagai jaring pengaman. */
  const kunci = laci[pasangan] ? pasangan
    : Object.keys(laci).find((k) => k.toUpperCase() === String(pasangan).toUpperCase());
  if (!kunci) return null;

  for (const tf of TF_NILAI_MT5) {
    const isi = laci[kunci][tf];
    if (!isi || !Array.isArray(isi.data) || !isi.data.length) continue;
    if (Number(isi.data[0][0]) > sejak) continue;          // tidak menjangkau awal sinyalnya
    const potong = isi.data.filter((k) => Number(k[0]) >= sejak);
    if (potong.length) return potong;
  }
  return null;
}

/* ── LILIN MT5 UNTUK MENILAI SATU SINYAL ────────────────────────────────
   DULU FUNGSI INI MEMBACA BENTUK YANG SUDAH TIDAK ADA. Sebelum data MT5
   dipisah per pengguna, mt5-klines.json berbentuk datar: { simbol: { tf } }.
   Sesudah dipisah ia jadi { uid: { login: { simbol: { tf } } } } — dan baris
   yang mencari `semua[pasangan]` tiba-tiba mencari "XAUUSD" di antara
   daftar UID. Tidak pernah ketemu, memulangkan null, dan penilainya berhenti
   di penjaga `if (!lilin) continue` satu baris kemudian.

   Akibatnya persis yang diperingatkan catatan di bawah, dan kembali lagi
   lewat pintu belakang: SETIAP sinyal Trade-Fi berhenti dinilai. Harganya
   sudah menembus entry, sudah kena TP, tapi kartunya tetap tertulis
   "Menunggu harga" selamanya. Tidak ada galat di mana pun — cuma angka yang
   diam. Dilaporkan pemilik 25 Agu 2026 dari sinyal XAUUSD Agen Momentum.

   LACI SENDIRI DULU, ACUAN BELAKANGAN. Aturan yang sama persis dengan chart:
   kalau yang memposting punya terminal sendiri dan simbolnya ada di sana,
   itu yang dipakai. Menilai sinyal orang dengan harga broker lain bukan
   ketidakrapian — XAUUSD dua broker bisa berbeda beberapa dolar, dan stop
   agen ini cuma sebelas dolar. Selisih brokernya saja sudah cukup membalik
   menang jadi kalah. */
function lilinMt5Sejak(pasangan, sejak, uid) {
  const semua = mt5KlinesBaca();

  if (uid && semua[uid]) {
    for (const lg of Object.keys(semua[uid])) {
      const hasil = lilinDariLaci(semua[uid][lg], pasangan, sejak);
      if (hasil) return hasil;
    }
  }

  /* Agen tidak punya terminal, dan begitu juga analis yang belum memasang
     EA. Untuk mereka dipakai feed acuan pemilik — feed yang SAMA dengan yang
     tergambar di chart publik, jadi hasilnya bisa diperiksa siapa pun dengan
     mata sendiri. */
  const a = mt5LaciAcuan(semua, mt5Baca());
  return lilinDariLaci(a && a.laci, pasangan, sejak);
}

async function nilaiSemuaAnalisa() {
  const d = analisaBaca();
  let berubah = false;

  for (const a of d.daftar) {
    if (a.hasil) continue;                                   // sudah selesai, tidak perlu diperiksa lagi
    /* DUA SUMBER LILIN, dipilih dari bentuk pasangannya.
       ────────────────────────────────────────────────────────────────
       Baris ini dulu berbunyi "kalau bukan ...USDT, lewati". Akibatnya
       SETIAP sinyal Trade-Fi tidak pernah dinilai: XAUUSD yang harganya
       sudah jauh melewati TP tetap tertulis "Berjalan" selamanya, tidak
       pernah masuk hitungan menang/kalah, dan winrate analisnya diam-diam
       cuma mengukur sinyal kriptonya.

       Itu melubangi janji utama papan ini — bahwa angkanya dihitung dari
       lilin sungguhan. Setengah dari sinyalnya memang tidak pernah
       dihitung sama sekali.

       Lilin MT5 sudah ada di server: EA mengirimnya tiap beberapa menit
       untuk tiap simbol yang dipasangi (mt5-klines.json), bentuknya
       [waktuMs, o, h, l, c] — persis yang dibaca telusuri(). Jadi yang
       kurang cuma menyambungkannya. */
    const kripto = /^[A-Z0-9]+USDT$/.test(a.pasangan || '');
    const { entry, sl, tp } = a.isi || {};
    if (!entry || !sl || !tp) continue;
    if (Date.now() - a.dibuat > NILAI_MAKS_HARI * 86400000) continue;

    const lilin = kripto
      ? await ambilKlines(a.pasangan, a.dibuat)
      : lilinMt5Sejak(a.pasangan, a.dibuat, a.uid);

    /* JENIS ENTRY DITENTUKAN DI SINI, DI ATAS PENJAGA LILIN.
       ────────────────────────────────────────────────────────────────
       Ia tidak butuh riwayat sama sekali — cukup satu angka, harga pasar
       saat sinyalnya dibuat. Menaruhnya di bawah penjaga membuatnya ikut
       menunggu lilin 15 menit yang dipakai menilai HASIL, dan selama
       menunggu itu tombol Batalkan tidak muncul di sinyal kripto.
       Dilaporkan pemilik: di Trade-Fi ikonnya ada, di kripto tidak.

       Untuk kripto dipakai lilin 1 MENIT supaya jawabannya datang dalam
       hitungan detik, bukan seperempat jam. Untuk MT5 lilin yang sudah
       diambil sudah cukup halus (TF_NILAI_MT5 dimulai dari '1m'). */
    if (!a.jenisEntry) {
      const awal = kripto ? await ambilKlines1m(a.pasangan, a.dibuat) : lilin;
      if (awal && awal.length) {
        const j = jenisEntry(a.arah, entry, Number(awal[0][1]));
        if (j) { a.jenisEntry = j; berubah = true; }
      }
    }

    if (!lilin || !lilin.length) continue;

    /* ── JENIS ENTRY DITULIS SEKALI, LALU DIBEKUKAN ────────────────────
       Dulu baris ini menghitung ulang jenis order tiap lima menit dari
       harga SAAT ITU. Akibatnya jenis sebuah order berubah-ubah mengikuti
       pasar: Buy Stop yang harganya mendekat jadi "Market" begitu jaraknya
       di bawah 0,05%, lalu balik jadi "Buy Stop" saat pasar menjauh lagi.

       Tiga hal rusak karenanya:

       1. Kartunya berkedip. Lencana keadaan dibaca dari jenis ini, jadi
          satu sinyal yang sama berpindah antara "Berjalan" dan "Menunggu
          harga" tanpa ada yang terjadi di pasar. Itu laporan pemiliknya.

       2. Pembatalan ikut terkunci diam-diam. Gerbang di /api/analisa/batal
          menolak order "Market", jadi analis yang order menggantungnya
          kebetulan sedang berada di dekat harga TIDAK BISA menariknya —
          padahal order itu belum terisi sama sekali.

       3. Ia berbohong soal jenis ordernya. Buy Limit yang dilewati harga
          tertulis jadi "Buy Stop", padahal yang diposting analisnya Buy
          Limit. Jenis order itu fakta tentang rencananya saat dibuat, bukan
          tentang di mana pasar berdiri hari ini.

       Sekarang ia ditulis pada penilaian pertama dan tidak pernah disentuh
       lagi. Yang bergerak mengikuti pasar adalah `terisi` — dan itu memang
       ditulis dari lilin, sekali, tanpa pernah dicabut. */
    const h = telusuri(lilin, { arah: a.arah, entry, sl, tp });
    /* Sekali terisi, selamanya terisi — tidak pernah dicabut kembali.
       Order yang sempat kena entry lalu harganya menjauh tetap posisi yang
       pernah jalan, dan menariknya sesudah itu tetap menghapus jejak. */
    if (h.terisi && !a.terisi) { a.terisi = true; a.waktuIsi = h.waktuIsi; berubah = true; }
    if (h.hasil) {
      a.hasil = h.hasil;
      a.waktuHasil = h.waktu;
      /* Imbalan : risiko dibekukan saat sinyalnya selesai. Dipakai menghitung
         estimasi hasil, dan disimpan supaya angkanya tidak berubah kalau
         suatu saat levelnya disunting. */
      a.rr = Math.abs(tp - entry) / Math.abs(entry - sl) || 0;
      berubah = true;
      console.log(`[analisa] ${a.pasangan} ${a.arah} -> kena ${h.hasil.toUpperCase()} @ ${new Date(h.waktu).toISOString()}`);
    }
  }

  if (!berubah) return;

  /* Dibaca ULANG tepat sebelum menulis, lalu hanya field hasil hitungan
     yang ditempelkan. Snapshot `d` sudah berumur beberapa detik sampai
     beberapa menit di titik ini — menulisnya utuh akan menghapus analisa
     yang diposting orang selama penilai menunggu jaringan. */
  const segar = analisaBaca();
  const perubahan = new Map(d.daftar.map((a) => [a.id, a]));
  for (const a of segar.daftar) {
    const p = perubahan.get(a.id);
    if (!p) continue;
    if (p.jenisEntry && !a.jenisEntry) a.jenisEntry = p.jenisEntry;   // sekali tulis, lihat catatan di penilai
    if (p.terisi && !a.terisi) { a.terisi = true; a.waktuIsi = p.waktuIsi; }
    if (p.hasil) { a.hasil = p.hasil; a.waktuHasil = p.waktuHasil; a.rr = p.rr; }
  }
  analisaTulis(segar);
}

// Jalan sekali saat start (supaya kartu langsung punya status sesudah restart),
// lalu berkala. unref() dipasang supaya timer ini tidak menahan proses keluar.
const nilaiAman = () => nilaiSemuaAnalisa().catch((e) =>
  console.error('[analisa] penilai gagal:', e && e.message ? e.message : e));
setTimeout(nilaiAman, 10000).unref();
setInterval(nilaiAman, NILAI_JEDA_MS).unref();

/* ── JALUR CEPAT: nilai dari tick hidup ─────────────────────────────────
   Tick yang dipakai adalah relai harga broker yang sama dengan yang
   mengeksekusi stop sungguhan — jadi "kena menurut tick" dan "kena
   menurut broker" adalah satu kejadian, bukan dua taksiran. SL didahulukan
   saat keduanya terlampaui di satu tick, sama dengan sikap telusuri().

   Sisi harganya sisi yang benar-benar dipakai broker: posisi BUY ditutup
   di BID (SL & TP), posisi SELL ditutup di ASK. Ask 0 berarti EA lama
   yang belum mengirimnya — bid dipakai sebagai pendekatan, lebih baik
   sedikit kasar daripada buta. */
function tickUntuk(pasangan, uidAnalis) {
  const dasar = String(pasangan || '').replace(/^MT5:/i, '').toUpperCase();
  const cocok = (laci) => {
    if (!laci) return null;
    for (const lg of Object.keys(laci)) {
      for (const sim of Object.keys(laci[lg] || {})) {
        if (sim === dasar || sim.startsWith(dasar)) {
          const t = laci[lg][sim];
          if (t && Date.now() - t.waktu < 90_000) return t;
        }
      }
    }
    return null;
  };
  /* Laci analisnya sendiri dulu, feed lain belakangan — aturan yang sama
     dengan penilai lilin: menilai sinyal orang dengan harga broker lain
     bisa membalik menang jadi kalah pada stop yang sempit. */
  if (uidAnalis && MT5_TICK[uidAnalis]) {
    const t = cocok(MT5_TICK[uidAnalis]);
    if (t) return t;
  }
  for (const uid of Object.keys(MT5_TICK)) {
    const t = cocok(MT5_TICK[uid]);
    if (t) return t;
  }
  return null;
}

function nilaiDariTick() {
  const d = analisaBaca();
  const perubahan = [];
  for (const a of d.daftar) {
    if (a.hasil) continue;
    if (/^[A-Z0-9]+USDT$/.test(a.pasangan || '')) continue;   // kripto dinilai dari klines Binance
    const { entry, sl, tp } = a.isi || {};
    if (!entry || !sl) continue;
    if (Date.now() - a.dibuat > NILAI_MAKS_HARI * 86400000) continue;

    const t = tickUntuk(a.pasangan, a.uid);
    if (!t) continue;
    const bid = t.bid;
    const ask = t.ask > 0 ? t.ask : t.bid;
    const buy = a.arah === 'BUY';
    const waktu = t.tb || Date.now();

    /* TERISI dari tick — jenis ordernya menentukan sisi sentuhannya.
       Limit menunggu harga TURUN ke entry (BUY) / NAIK ke entry (SELL);
       Stop kebalikannya; Market terisi sejak awal. jenisEntry ditulis
       penilai lilin sekali dan tidak pernah diubah, jadi aman dibaca. */
    let terisi = a.terisi === true;
    if (!terisi) {
      const je = String(a.jenisEntry || '');
      if (/market/i.test(je)) terisi = true;
      else if (/limit/i.test(je)) terisi = buy ? ask <= entry : bid >= entry;
      else if (/stop/i.test(je)) terisi = buy ? ask >= entry : bid <= entry;
      /* jenisEntry belum ditulis (penilai lilin belum pernah menyentuhnya):
         jangan menebak — biarkan penilai lilin yang menentukan. */
      if (terisi && !a.terisi) perubahan.push({ id: a.id, terisi: true, waktuIsi: waktu });
    }
    if (!terisi) continue;

    const kenaSl = buy ? bid <= sl : ask >= sl;
    const kenaTp = tp > 0 && (buy ? bid >= tp : ask <= tp);
    if (!kenaSl && !kenaTp) continue;
    const hasil = kenaSl ? 'sl' : 'tp';
    perubahan.push({
      id: a.id, terisi: true, waktuIsi: a.waktuIsi || waktu,
      hasil, waktuHasil: waktu,
      rr: Math.abs((tp || entry) - entry) / Math.abs(entry - sl) || 0,
    });
    console.log('[analisa-tick] ' + a.pasangan + ' ' + a.arah + ' -> kena ' + hasil.toUpperCase() + ' (tick hidup)');
  }
  if (!perubahan.length) return;

  /* Baca ulang tepat sebelum menulis — aturan yang sama dengan penilai
     lilin: snapshot yang berumur beberapa detik tidak boleh menimpa
     analisa yang baru diposting orang di sela-selanya. */
  const segar = analisaBaca();
  const peta = new Map(perubahan.map((p) => [p.id, p]));
  for (const a of segar.daftar) {
    const p = peta.get(a.id);
    if (!p || a.hasil) continue;
    if (p.terisi && !a.terisi) { a.terisi = true; a.waktuIsi = p.waktuIsi; }
    if (p.hasil) { a.hasil = p.hasil; a.waktuHasil = p.waktuHasil; a.rr = p.rr; }
  }
  analisaTulis(segar);
}
const tickAman = () => { try { nilaiDariTick(); } catch (e) { console.error('[analisa-tick] gagal:', e && e.message); } };
setInterval(tickAman, 3000).unref();


/* ════════════════════════════════════════════════════════════════════
   PROFIL ANALIS — nama tampilan & avatar
   ════════════════════════════════════════════════════════════════════
   Sebelum ini nama analis disimpan PER REKAMAN analisa, diambil sekali
   dari akun Google saat memposting. Akibatnya nama tidak bisa diubah
   (rekaman lama tetap memakai yang lama), dan tidak ada tempat sama
   sekali untuk foto.

   KENAPA DI SERVER, BUKAN DI FIRESTORE. Yang membaca nama & avatar
   adalah ORANG LAIN — papan peringkat dan kartu kanal menampilkan analis
   selain dirinya. Aturan Firestore mengunci users/{uid} untuk pemiliknya
   sendiri, jadi profil di sana tidak akan pernah terbaca siapa pun
