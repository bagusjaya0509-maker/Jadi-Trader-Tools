const SL_MAKS_TF = {
  '1m': 0.25, '3m': 0.3, '5m': 0.35, '15m': 0.5, '30m': 0.8,
  '1h': 1.2, '2h': 1.8, '4h': 3.5, '6h': 4.5, '8h': 5.5, '12h': 7,
