   angka yang kebetulan tinggi", dan yang kedua akan mengejutkan seseorang
   suatu hari. */
const PAKET = {
  /* `riwayat` = berapa kali "Muat lebih lama" boleh menarik 1000 lilin
     sebelum yang paling tua. Sama seperti screener & replay, angkanya
     dihitung PER PERIODE LISENSI - untuk akun tanpa lisensi (gratis)
     periodenya 0 dan tidak pernah berganti, jadi praktisnya jatah seumur
     akun, bukan harian. Itu perilaku yang sama dengan dua fitur lain di
     baris ini, dan menyendirikan satu fitur dengan aturan reset yang
     berbeda cuma akan menyulitkan siapa pun yang membacanya nanti.

     2 untuk gratis dan -1 untuk SEMUA paket berbayar: keputusan pemilik
     22 Agu 2026. Riwayat panjang jadi salah satu alasan orang membayar,
     jadi yang gratis cukup diberi rasanya. */
  gratis:    { screener: 10, replay: 20,  riwayat: 2,   copySignal: false, marketplace: false, postingSinyal: false },
  /* PRATINJAU 24 JAM - bukan paket yang dijual, melainkan keadaan sementara.

     Keputusan pemilik 19 Agu 2026: masa coba harus memperlihatkan produk
     yang SEBENARNYA. Sebelum ini orang yang menekan Preview jatuh ke batas
     'gratis' (10 screener, 20 replay, Copy Signal terkunci) - ia melihat
     versi yang lebih sempit daripada yang dijual, lalu diminta membayar
     untuk sesuatu yang belum pernah ia coba utuh. Masa coba yang dilumpuhkan
     tidak meyakinkan siapa pun; yang diperlihatkannya cuma pagarnya.

     DUA hal sengaja TIDAK ikut dibuka:

     1. marketplace - isinya berkas indikator & EA yang SEKALI DIUNDUH jadi
        milik pengunduh selamanya. Kuota screener yang habis dalam 24 jam
        tidak menghilangkan apa pun; berkas yang sudah terunduh tidak bisa
        ditarik kembali. Ini juga satu-satunya pembeda paket Tahunan, dan
        membagikannya gratis menghapus alasan orang membelinya.

     2. postingSinyal - orang yang baru masuk 24 jam tidak boleh menyiarkan
        sinyal ke pengikut. Sinyal TIDAK BISA DIHAPUS setelah diposting dan
        ikut dihitung papan peringkat; akun sekali-pakai yang memposting
        lalu menghilang meninggalkan jejak permanen di papan yang dipakai
        analis sungguhan untuk membangun reputasinya. */
  /* riwayat -1 atas keputusan pemilik 22 Agu 2026, sejalan dengan alasan
     dua baris di atas: masa coba harus memperlihatkan produk yang
     SEBENARNYA. Riwayat panjang justru salah satu hal yang paling terasa
     ketika orang menilai apakah alat ini layak dibayar. */
  pratinjau: { screener: -1, replay: -1,  riwayat: -1,  copySignal: true,  marketplace: false, postingSinyal: false },
  testing:   { screener: 50, replay: 100, riwayat: -1,  copySignal: true,  marketplace: false, postingSinyal: true  },
  premium3:  { screener: -1, replay: -1,  riwayat: -1,  copySignal: true,  marketplace: false, postingSinyal: true  },
  tahunan:   { screener: -1, replay: -1,  riwayat: -1,  copySignal: true,  marketplace: true,  postingSinyal: true  },
};

/* Paket yang boleh DIPASANG ke sebuah lisensi. 'pratinjau' sengaja di luar
   daftar: ia dihitung dari jam, bukan diberikan, dan baris lisensi bertulis
   'pratinjau' akan berlaku SELAMANYA - persis kebalikan dari maksudnya. */
const PAKET_DIJUAL = ['gratis', 'testing', 'premium3', 'tahunan'];

const MS_PRATINJAU = 24 * 3600 * 1000;

/* Baris lisensi lama belum punya medan `paket`. Dianggap 'gratis' — itu
   memang asalnya (sampai hari ini belum ada satu pun permintaan berbayar
   yang disetujui), dan menebak ke arah yang lebih longgar berarti membagikan
   akses berbayar kepada orang yang tidak membelinya. */
function paketDari(baris) {
  const p = baris && baris.paket;
  if (Object.prototype.hasOwnProperty.call(PAKET, p)) return p;
  /* Lisensi BERBAYAR tanpa paket tertulis jatuh ke tingkat berbayar
     TERMURAH, bukan ke gratis. Baris lama dibuat sebelum medan `paket` ada,
     dan menurunkan orang yang sudah membayar ke tingkat gratis adalah
     kegagalan yang memihak ke arah yang salah: yang rugi pelanggannya, dan
     ia tidak punya cara tahu kenapa. Panel lisensi sudah lama membacanya
     begini juga - "kosong berarti paket termurah". */
  if (baris && baris.jenis === 'bayar') return 'testing';
  return 'gratis';
}

/* HARGA PERKENALAN BERLAKU SEKALI PER AKUN.

   Tanpa aturan ini, masa akses 30 hari yang habis lalu diminta lagi akan
   dibeli di harga promo lagi — berulang, selamanya. Yang terbentuk bukan
   promo peluncuran melainkan kelompok pelanggan berharga tetap $1, dan
   menaikkan mereka ke harga normal nanti akan terasa seperti ingkar janji,
   bukan seperti promo yang memang berakhir.

   Ditentukan dari RIWAYAT, bukan dari penanda tersendiri: satu permintaan
   berbayar yang pernah disetujui sudah cukup membuktikannya. Penanda
   terpisah bisa lupa ditulis; riwayat tidak bisa lupa terjadi. */
function promoTerpakai(d, uid) {
  return lisensiPermintaan(d).some(x =>
    x.uid === uid && x.status === 'disetujui' && x.jenis === 'bayar');
}

function lisensiUid(d, uid) {
  return (d.aktif || []).find(x => x.uid === uid && (!x.berakhir || x.berakhir > Date.now())) || null;
}

/* Kuota dihitung per PERIODE lisensi, bukan per bulan kalender. Penandanya
   stempel `berakhir` milik lisensinya sendiri: begitu orangnya memperpanjang
   atau naik paket, `berakhir` berubah dan hitungannya mulai dari nol lagi.

   Kalau dipakai bulan kalender, orang yang membeli tanggal 28 kehilangan
   hampir seluruh jatahnya dalam tiga hari. */
function pakaiBaca(d, uid, baris) {
  const semua = d.pakai || (d.pakai = {});
  const periode = baris && baris.berakhir ? baris.berakhir : 0;
  let r = semua[uid];
  if (!r || r.periode !== periode) {
    r = semua[uid] = { periode, screener: 0, replay: 0, riwayat: 0 };
  }
  return r;
}

/* Sampai kapan pratinjau uid ini berlaku (0 = tidak ada / sudah lewat).

   GAGAL KE ARAH TERTUTUP, berbeda dari statusLangganan yang sengaja
   meloloskan orang saat Firestore tidak terjawab. Alasannya tidak sama: di
   sana yang terancam PELANGGAN YANG SUDAH BAYAR, dan menguncinya karena
   Google sedang lambat merugikan orang yang tidak salah apa-apa. Di sini
   yang diperebutkan akses GRATIS - kalau statusnya tidak terbaca, turun ke
   batas 'gratis' cuma merepotkan sebentar, sedangkan meloloskan berarti
   membuka akses penuh untuk SEMUA orang tiap kali Firestore batuk. */
async function pratinjauSampai(uid, idToken) {
  if (!idToken) return 0;
  try {
    const st = await statusLangganan(uid, idToken);
    const sampai = Number(st && st.praSampai) || 0;
    return sampai > Date.now() ? sampai : 0;
  } catch (e) {
    return 0;
  }
}

function ringkasPaket(d, uid, praSampaiMs) {
  const baris = lisensiUid(d, uid);
  /* Urutannya yang penting.

     Lisensi sungguhan SELALU menang atas pratinjau - orang yang membeli
     saat pratinjaunya masih berjalan tidak boleh turun haknya.

     Pemilik lewat sebagai 'tahunan'. Tanpa ini ia terbentur batas 10
     screener di alatnya sendiri, karena ia memang tidak punya baris
     lisensi - dan itu jenis pagar yang baru ketahuan saat sedang sibuk. */
  const nama = uid === OWNER_UID ? 'tahunan'
             : baris             ? paketDari(baris)
             : praSampaiMs       ? 'pratinjau'
             : 'gratis';
  const batas = PAKET[nama];
  const st = bacaSetelan(d);
  const pakai = pakaiBaca(d, uid, baris);
  const sisa = (k) => (batas[k] < 0 ? -1 : Math.max(0, batas[k] - (pakai[k] || 0)));
  return {
    paket: nama,
    aktif: !!baris || nama === 'pratinjau' || uid === OWNER_UID,
    berakhir: baris && baris.berakhir ? baris.berakhir
            : nama === 'pratinjau'    ? praSampaiMs
            : 0,
    batas: { screener: batas.screener, replay: batas.replay, riwayat: batas.riwayat },
    pakai: { screener: pakai.screener || 0, replay: pakai.replay || 0, riwayat: pakai.riwayat || 0 },
    sisa: { screener: sisa('screener'), replay: sisa('replay'), riwayat: sisa('riwayat') },
    copySignal: batas.copySignal,
    marketplace: batas.marketplace,
    postingSinyal: !!batas.postingSinyal,
    /* Harga yang BERLAKU untuk orang ini, bukan harga yang dipajang di
       halaman depan. Halaman depan tidak tahu siapa pembacanya; halaman
       Akses tahu, dan di sanalah angka yang mengikat harus muncul. */
    promoTerpakai: promoTerpakai(d, uid),
    hargaBerlaku: promoTerpakai(d, uid) ? st.hargaTestingCoret : st.hargaTesting,
  };
}

/* Keadaan paket orang yang sedang login. Dibaca tiap halaman berpagar
   dibuka, jadi dibuat murah: baca berkas, hitung, jawab. */
app.get('/api/paket', batasLaju, butuhLogin, async (req, res) => {
  const pra = await pratinjauSampai(req.uid, req.idToken);
  const d = lisensiBaca();
  const r = ringkasPaket(d, req.uid, pra);
  /* pakaiBaca bisa MEMBUAT baris baru (reset periode). Ditulis supaya
     resetnya tercatat, bukan dihitung ulang tiap permintaan. */
  lisensiTulis(d);
  res.json({ ok: true, ...r });
});

/* Memakai satu jatah. Jawabannya yang menentukan boleh atau tidak — bukan
   tampilan di browser. Halaman yang lupa memanggil ini akan lolos, jadi
   pagarnya tetap harus dipasang di tiap tempat; tapi halaman yang memanggil
   ini TIDAK BISA berbohong soal sisanya. */
app.post('/api/paket/pakai', batasLaju, butuhLogin, async (req, res) => {
  const fitur = String((req.body || {}).fitur || '');
  if (fitur !== 'screener' && fitur !== 'replay' && fitur !== 'riwayat') {
    return res.status(400).json({ error: 'fitur harus screener, replay, atau riwayat' });
  }
  const pra = await pratinjauSampai(req.uid, req.idToken);
  const d = lisensiBaca();
  const baris = lisensiUid(d, req.uid);
  /* Urutan yang SAMA PERSIS dengan ringkasPaket. Dua tempat yang memutuskan
     paket seseorang dengan aturan berbeda adalah dua tempat yang suatu hari
     berselisih - dan yang berselisih di sini boleh-atau-tidaknya sebuah
     fitur, bukan sekadar angka yang dipajang. */
  const nama = req.uid === OWNER_UID ? 'tahunan'
             : baris                 ? paketDari(baris)
             : pra                   ? 'pratinjau'
             : 'gratis';
  const batas = PAKET[nama][fitur];
  const pakai = pakaiBaca(d, req.uid, baris);

  if (batas >= 0 && (pakai[fitur] || 0) >= batas) {
    return res.status(403).json({
      error: 'Jatah ' + fitur + ' paket ini sudah habis.',
      kode: 'KUOTA_HABIS', paket: nama, batas, pakai: pakai[fitur] || 0,
    });
  }
  if (batas >= 0) { pakai[fitur] = (pakai[fitur] || 0) + 1; lisensiTulis(d); }
  res.json({ ok: true, ...ringkasPaket(d, req.uid, pra) });
});

/* Pemilik menetapkan paket seseorang. Sampai produk Xendit-nya jadi, inilah
   satu-satunya jalan menaikkan orang ke premium3 atau tahunan. */
app.post('/api/paket/set', batasLaju, requireToken, (req, res) => {
  const b = req.body || {};
  const uid = String(b.uid || '').trim();
  const paket = String(b.paket || '').trim();
  if (!uid) return res.status(400).json({ error: 'uid wajib diisi' });
  if (PAKET_DIJUAL.indexOf(paket) < 0) {
    return res.status(400).json({ error: 'paket tidak dikenal: ' + PAKET_DIJUAL.join(', ') });
  }
  const d = lisensiBaca();
  const baris = lisensiUid(d, uid);
  if (!baris) return res.status(404).json({ error: 'Orang ini belum punya lisensi aktif.' });
  baris.paket = paket;
  lisensiTulis(d);
  res.json({ ok: true, ...ringkasPaket(d, uid) });
});

app.get('/api/lisensi/cek', batasLaju, (req, res) => {
  const sidik = String(req.query.sidik || '');
