// ═══════════════════════════════════════════════════════════════════════════
// COPY SIGNAL — analisa agen AI + galeri foto bersama
// ═══════════════════════════════════════════════════════════════════════════
// Dua tambahan di atas Copy Trading yang sudah ada:
//
//   1. ANALISA AGEN AI. Ditulis di luar aplikasi lalu dikirim ke sini dengan
//      App Token, bukan ID token pengguna — agen bukan akun Firebase dan
//      memaksanya punya akun berarti menyimpan kredensial robot di suatu
//      tempat. Rekamannya diberi tanda `agen`, dan HANYA rute ini yang bisa
//      memasangnya: kalau flag itu boleh dikirim lewat POST /api/analisa
//      biasa, siapa pun yang login bisa menyamar jadi agen resmi.
//
//   2. GALERI FOTO BERSAMA. Foto chart menempel pada analisanya, bukan pada
//      orang yang mengunggahnya. Yang boleh menambah = yang boleh MEMBUKA
//      analisa itu (penulis, gratis, atau pembeli yang disetujui), dan yang
//      mereka unggah terlihat oleh semua yang lain di lingkaran yang sama.
//      Itu memang tujuannya: analisa jadi ruang diskusi, bukan pengumuman
//      satu arah.
//
// Batasnya disebut apa adanya di jawaban galat, bukan ditolak diam-diam.
/* PER AGEN, bukan satu kolam bersama.
   ──────────────────────────────────────────────────────────────────────
   Dulu 40 untuk SEMUA agen sekaligus. Begitu ada dua agen dengan irama
   berbeda, yang cepat menggusur yang lambat: agen scalping memposting
   beberapa kali sehari dan dalam sepekan ia sudah memakan seluruh jatah,
   termasuk sinyal agen tren yang butuh berbulan-bulan untuk terkumpul.
   Rekam jejak yang paling mahal dikumpulkan justru yang pertama hilang,
   dan papan peringkat menilai agen tren dari sisa potongannya.

   100 per agen: cukup untuk sampel yang berarti di kedua irama, dan tetap
   memangkas supaya berkasnya tidak berubah jadi arsip abadi. */
const AGEN_MAKS_ANALISA = 100;
const GALERI_MAKS = 12;         // per analisa
const GALERI_MAKS_ORANG = 4;    // per orang per analisa

/* Slug dari nama agen, bukan nomor acak: satu agen harus memakai uid yang
   sama seumur hidupnya, kalau tidak rekam jejaknya pecah tiap kali server
   dijalankan ulang. Awalan 'agen-' dibuang supaya hasilnya 'agen:tren',
   bukan 'agen:agen-tren'. */
function uidAgenDari(nama) {
  return 'agen:' + (String(nama || 'AI Agent').toLowerCase()
    .replace(/[^a-z0-9]+/g, '-').replace(/^agen-/, '').replace(/^-+|-+$/g, '') || 'ai');
}

/* ── KEHADIRAN AGEN ──────────────────────────────────────────────────────
   Agen memposting sinyal HANYA saat ada setup, dan agen tren bisa diam
   berhari-hari. Selama itu ia tidak punya satu pun baris di analisa.json,
   jadi papan Copy Signal tidak bisa menampilkannya sama sekali — pemilik
   maupun pengguna sama-sama melihat papan yang seolah tidak punya agen.

   Berkas ini yang menutup celah itu: tiap kali agen selesai memindai, ia
   mendaftarkan dirinya di sini, sinyal atau tidak. Dua akibat yang
   dua-duanya diinginkan:

   1. Kartunya bisa tampil sejak menit pertama, dengan keterangan strategi
      dan berapa pasangan yang dipantau.
   2. `terakhirPindai` jadi bukti cron masih hidup. Kalau cap waktunya
      berhenti bergerak, penjadwalnya mati — dan itu terlihat di layar,
      bukan cuma di log yang tidak pernah dibuka siapa pun.

   DAFTARNYA DIISI AGEN SENDIRI, tidak ditulis ulang di sini. Menyalin
   nama dan parameter strategi ke server berarti dua tempat memegang
   kebenaran yang sama, dan yang satu pasti tertinggal saat yang lain
   diubah. */
const AGEN_HADIR_FILE = path.join(__dirname, 'agen-hadir.json');
function agenHadirBaca() {
  try {
    const j = JSON.parse(fs.readFileSync(AGEN_HADIR_FILE, 'utf8'));
    return (j && typeof j === 'object' && j.agen) ? j : { agen: {} };
  } catch (e) {
    /* Berkas hilang atau rusak boleh dimulai dari kosong — beda dengan
       analisa.json. Isinya seluruhnya bisa dibangun ulang sendiri oleh
       denyut berikutnya beberapa menit lagi, jadi tidak ada yang hilang
       permanen. */
    return { agen: {} };
  }
}
function agenHadirTulis(d) {
  fs.writeFileSync(AGEN_HADIR_FILE, JSON.stringify(d, null, 2));
}

// Denyut kehadiran agen. Dikirim agen tiap selesai memindai, ada sinyal
// maupun tidak.
app.post('/api/analisa/agen/hadir', batasLaju, requireToken, (req, res) => {
  const { nama, tf, strategi, pasangan, sinyalBaru } = req.body || {};
  if (!nama) return res.status(400).json({ error: 'nama agen wajib diisi' });
  const uid = uidAgenDari(nama);
  const d = agenHadirBaca();
  const lama = d.agen[uid] || {};
  const kini = Date.now();
  const baru = Number(sinyalBaru) || 0;
  d.agen[uid] = {
    uid,
    nama: String(nama).slice(0, 40),
    tf: String(tf || '').slice(0, 6),
    strategi: String(strategi || '').slice(0, 160),
    pasangan: Math.max(0, Math.min(200, Number(pasangan) || 0)),
    terakhirPindai: kini,
    totalPindai: (Number(lama.totalPindai) || 0) + 1,
    /* Cap waktu sinyal terakhir hanya bergerak kalau memang ada yang
       diposting — kalau ikut diperbarui tiap pindai, ia jadi salinan
       terakhirPindai dan tidak memberi tahu apa pun. */
    terakhirSinyal: baru > 0 ? kini : (Number(lama.terakhirSinyal) || null),
    sinyalTotal: (Number(lama.sinyalTotal) || 0) + baru,
  };
  agenHadirTulis(d);
  res.json({ ok: true, uid });
});

// Daftar agen — PUBLIK. Kartu siaganya harus terlihat pengunjung yang belum
