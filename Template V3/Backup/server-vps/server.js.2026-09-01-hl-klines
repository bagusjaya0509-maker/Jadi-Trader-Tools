     membengkak megabyte dan ikut terkirim tiap kali papan peringkat
     dibuka. */
  if (typeof dataUrl === 'string' && dataUrl) {
    const m = dataUrl.match(/^data:(image[/](?:png|jpeg|webp));base64,(.+)$/);
    if (!m) return res.status(400).json({ error: 'Format gambar tidak dikenali (harus PNG/JPG/WebP)' });
    const buf = Buffer.from(m[2], 'base64');
    if (buf.length > 2 * 1024 * 1024) {
      return res.status(413).json({ error: 'Foto ' + (buf.length / 1048576).toFixed(1) + ' MB, batasnya 2 MB' });
    }
    const ext = { 'image/png': '.png', 'image/jpeg': '.jpg', 'image/webp': '.webp' }[m[1]];
    const berkas = 'avatar-' + req.uid.slice(0, 12) + '-' + Date.now().toString(36) + ext;
    try { fs.writeFileSync(path.join(GAMBAR_DIR, berkas), buf); }
    catch (e) { return res.status(500).json({ error: 'Gagal menyimpan: ' + e.message }); }
    /* Berkas LAMA dihapus sesudah yang baru berhasil ditulis, bukan
       sebelumnya: kalau penulisannya gagal, orangnya tetap punya avatar. */
    if (r.berkas && r.berkas !== berkas) {
      try { fs.unlinkSync(path.join(GAMBAR_DIR, r.berkas)); } catch (e) {}
    }
    r.berkas = berkas;
    r.foto = (req.headers['x-forwarded-proto'] || 'https') + '://' + req.headers.host + '/gambar/' + berkas;
    r.avatar = 'foto';
  }

  r.diubah = Date.now();
  p[req.uid] = r;
  profilTulis(p);
  res.json({ ok: true, profil: { nama: r.nama || '', avatar: r.avatar || 'anonim', foto: r.foto || '' } });
});

// Daftar publik: TANPA isi terkunci, TANPA daftar pembeli/permintaan.
/** Sinyal yang peluangnya sudah habis — sama persis dengan syarat yang
 *  membuka levelnya di /api/analisa/isi. Ditulis satu kali supaya kedua
 *  tempat tidak bisa menyimpang: level terbuka tapi sampul terkunci adalah
 *  bug yang tidak akan pernah terlihat sebagai galat. */
function sampulTerbuka(a) {
  return a.hasil === 'tp' || a.hasil === 'sl' || a.hasil === 'batal';
}

/* Seberapa baru kunjungan terakhir masih dihitung "sedang membuka". Dua
   kali jeda denyut peramban (2 menit), jadi satu denyut yang meleset karena
   jaringan tidak langsung memadamkan lampunya. */
const AKTIF_MS = 5 * 60 * 1000;

app.get('/api/analisa', batasLaju, (req, res) => {
  const d = analisaBaca();
  const prof = profilBaca();
  /* KEHADIRAN ANALIS, bukan kehadiran semua orang.
     ────────────────────────────────────────────────────────────────────
     Yang dipulangkan cuma untuk uid yang MEMANG SUDAH MEMPOSTING sinyal di
     daftar ini — orang yang memilih tampil di depan umum sebagai analis.
     Pengunjung biasa tidak pernah muncul di sini, jadi rute publik ini
     tidak bisa dipakai mengintip siapa yang sedang online.

     Boolean, bukan cap waktu. "Sedang membuka" cukup untuk memutuskan
     apakah sinyal barunya mungkin segera datang; jam berapa persisnya
     seseorang membuka situs bukan urusan orang lain. */
  const lap = laporBaca();
  res.json({ daftar: d.daftar.map(a => ({
    id: a.id, uid: a.uid, nama: profilPakai(prof, a.uid, a.nama).nama,
    foto: profilPakai(prof, a.uid, a.nama).foto,
    aktif: Date.now() - Number(((lap.klien || {})[a.uid] || {}).terakhir || 0) < AKTIF_MS,
    judul: a.judul, pasangan: a.pasangan,
    arah: a.arah, harga: a.harga, ringkas: a.ringkas, dibuat: a.dibuat,
    snapshot: a.snapshot || null, jumlahPembeli: (a.pembeli || []).length,
    jumlahCopy: (a.pengcopyUid || []).length,
    agen: !!a.agen, tf: a.tf || '', jumlahGambar: (a.galeri || []).length,
    pasar: a.pasar || (/USDT$/.test(a.pasangan || '') ? 'kripto' : 'tradefi'),
    hasil: a.hasil || null, waktuHasil: a.waktuHasil || null, jenisEntry: a.jenisEntry || '',
    terisi: !!a.terisi, alasanBatal: a.alasanBatal || '',
    /* HASIL DOLAR PER SINYAL - hanya untuk yang SUDAH SELESAI.
       ──────────────────────────────────────────────────────────────────
       Dipakai kalender performa di kanal analis, yang menempatkan tiap
       sinyal di harinya beserta hasilnya.

       DIHITUNG DI SINI, bukan di browser, dan itu bukan kerewelan: rumus
       yang sama sudah dipakai /api/analisa/performa untuk papan peringkat.
       Kalau browser menghitungnya sendiri dari rr, dua tempat memegang
       rumus yang sama dan suatu hari salah satunya berubah - persis cara
       kalender dan papan peringkat mulai berselisih tanpa ada yang tahu.

       HANYA yang selesai. Untuk sinyal yang masih berjalan, angka ini
       memberitahukan rr-nya, dan rr adalah jarak TP terhadap SL - itu
       produk yang dijual analisnya. Sinyal yang sudah kena TP/SL tidak
       bisa ditiru lagi, jadi rekam jejaknya boleh terbuka; yang masih
       jalan tidak. Batal juga tidak: tidak ada uang yang berpindah, dan
       menuliskannya nol akan terbaca sebagai impas, bukan sebagai tidak
       terjadi. */
    hasilDolar: (a.hasil === 'tp' || a.hasil === 'sl')
      ? Math.round(((a.hasil === 'tp' ? (Number(a.rr) || 0) : -1)
                    * MODAL_ESTIMASI * (RISIKO_PERSEN / 100)) * 100) / 100
      : null,
    /* Sampul mengikuti aturan yang SAMA dengan levelnya (lihat gerbang di
       /api/analisa/isi): gratis, milik sendiri, sudah dibeli, atau SUDAH
       SELESAI. Tanpa syarat terakhir ini kartunya jadi setengah jujur —
       levelnya sudah dibuka gratis dan lencananya menulis "Terbuka gratis",
       tapi sampulnya masih bergembok "terbuka setelah dibeli". Dua pesan
       yang bertentangan di kartu yang sama membuat orang tidak tahu mana
       yang benar. */
    /* Level untuk kartu: entry buat ditampilkan, entry+SL buat menghitung
       P/L berjalan. Gerbangnya sama dengan sampul tepat di bawah ini. */
    isiTerbuka: (a.harga === 0 || sampulTerbuka(a)) && a.isi
      ? { entry: Number(a.isi.entry) || 0, sl: Number(a.isi.sl) || 0, tp: Number(a.isi.tp) || 0 }
      : null,
    sampul: (a.harga === 0 || sampulTerbuka(a)) ? ((a.galeri || [])[0] || {}).url || '' : '',
    adaSampul: (a.galeri || []).length > 0,
  })) });
});

