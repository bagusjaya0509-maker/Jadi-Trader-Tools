// Siapa yang boleh MEMBUKA analisa ini. Satu definisi, dipakai rute isi dan
// rute galeri — dua salinan aturan akses adalah dua peluang berselisih.
function analisaBolehBuka(a, uid) {
  return a.uid === uid || a.harga === 0 || (a.pembeli || []).includes(uid);
}

// Tambah foto ke galeri sebuah analisa.
app.post('/api/analisa/gambar', batasLaju, butuhLogin, express.json({ limit: '12mb' }), (req, res) => {
  const { id, dataUrl, ket, nama } = req.body || {};
  const d = analisaBaca();
  const a = d.daftar.find(x => x.id === String(id || ''));
  if (!a) return res.status(404).json({ error: 'Analisa tidak ditemukan' });
  if (!analisaBolehBuka(a, req.uid)) {
    return res.status(403).json({ error: 'Buka aksesnya dulu sebelum menambah foto' });
  }

  a.galeri = a.galeri || [];
  if (a.galeri.length >= GALERI_MAKS) {
    return res.status(400).json({ error: 'Galeri penuh (maksimal ' + GALERI_MAKS + ' foto)' });
  }
  if (a.galeri.filter(g => g.uid === req.uid).length >= GALERI_MAKS_ORANG) {
    return res.status(400).json({ error: 'Maksimal ' + GALERI_MAKS_ORANG + ' foto per orang di satu analisa' });
  }

  const m = String(dataUrl || '').match(/^data:(image\/(?:png|jpeg|webp));base64,(.+)$/);
  if (!m) return res.status(400).json({ error: 'Format gambar tidak dikenali (harus PNG/JPG/WebP)' });
  const buf = Buffer.from(m[2], 'base64');
  if (buf.length > 5 * 1024 * 1024) {
    return res.status(413).json({ error: 'Gambar ' + (buf.length / 1048576).toFixed(1) + ' MB, batasnya 5 MB' });
  }

  const ext = { 'image/png': '.png', 'image/jpeg': '.jpg', 'image/webp': '.webp' }[m[1]];
  const berkas = 'analisa-' + a.id + '-' + Date.now().toString(36) + ext;
  try { fs.writeFileSync(path.join(GAMBAR_DIR, berkas), buf); }
  catch (e) { return res.status(500).json({ error: 'Gagal menyimpan: ' + e.message }); }

  const asal = (req.headers['x-forwarded-proto'] || 'https') + '://' + req.headers.host;
  const g = {
    id: 'g' + Date.now().toString(36) + Math.random().toString(36).slice(2, 5),
    url: asal + '/gambar/' + berkas, berkas,
    ket: String(ket || '').slice(0, 140),
    uid: req.uid, nama: String(nama || '').slice(0, 40) || 'Pengguna', waktu: Date.now(),
  };
  a.galeri.push(g);
  analisaTulis(d);
  res.json({ ok: true, gambar: g });
});

