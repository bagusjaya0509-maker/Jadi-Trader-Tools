  const pelanggaranLalu = new Map();
  for (const a of d.daftar) {
    if (a.hasil !== 'tp' && a.hasil !== 'sl') continue;
    if (kunciBulan(a.waktuHasil || a.dibuat) !== periodeLalu) continue;
    const sl = slPersenSinyal(a);
    if (sl !== null && sl > batasSl(a)) {
      const k = a.uid || 'tanpa-uid';
      pelanggaranLalu.set(k, (pelanggaranLalu.get(k) || 0) + 1);
    }
  }

  for (const a of d.daftar) {
    if (a.hasil !== 'tp' && a.hasil !== 'sl' && a.hasil !== 'batal') continue;
    if (kunciBulan(a.waktuHasil || a.dibuat) !== periode) continue;
    const kunci = a.uid || 'tanpa-uid';
    if (!peta.has(kunci)) {
      peta.set(kunci, {
        uid: kunci, nama: profilPakai(prof, a.uid, a.nama).nama,
        foto: profilPakai(prof, a.uid, a.nama).foto, agen: !!a.agen,
        menang: 0, kalah: 0, batal: 0, hasilDolar: 0, terakhir: 0, harian: {},
        /* Jarak SL, dijumlahkan lalu dirata-ratakan di bawah. Lihat
           catatan panjang di tempat pengisiannya. */
        slJumlah: 0, slN: 0, slMaks: 0, pelanggaran: 0,
      });
    }
    const p = peta.get(kunci);

    /* Dibatalkan: dihitung terpisah dan berhenti di sini. Ia bukan kalah —
       tidak ada uang yang hilang — tapi juga bukan bukan-peristiwa. */
    if (a.hasil === 'batal') {
      p.batal++;
      p.terakhir = Math.max(p.terakhir, a.waktuHasil || a.dibuat);
      continue;
    }
    const rr = Number(a.rr) || 0;
    const dolar = a.hasil === 'tp' ? rr * risiko : -risiko;

    /* ── JARAK SL SEBAGAI PERSEN HARGA — parameter risiko yang sungguhan
       ────────────────────────────────────────────────────────────────────
       Kartu analis selama ini cuma menulis "Risiko rendah/sedang/tinggi".
       Itu penilaian tanpa angka, dan pembaca tidak punya cara memeriksanya.

       KENAPA BUKAN "PERSEN DARI MODAL", yang lebih diminta orang: karena
       tidak ada yang tahu, termasuk analisnya. Sinyal berisi entry, SL, dan
       TP — TIDAK berisi ukuran posisi. Berapa persen modal yang berisiko
       ditentukan oleh lot yang dipakai PENIRUNYA, bukan oleh sinyalnya.
       Angka apa pun yang ditaruh di sana akan karangan, dan karangan di
       kolom bernama "risiko" adalah jenis kebohongan yang paling mahal di
       halaman ini.

       Yang benar-benar milik analisnya adalah jarak SL-nya: seberapa jauh
       ia membiarkan harga melawan sebelum menyerah. Dua analis dengan
       winrate sama tapi SL 0,3% dan 3% adalah dua hal yang sangat berbeda,
       dan sekarang bedanya terbaca.

       AMAN DITAYANGKAN, dan gerbangnya sudah ada di atas: gelung ini cuma
       menyentuh sinyal yang hasilnya sudah jatuh, dan level sinyal selesai
       memang sudah terbuka gratis untuk siapa pun. Tidak ada satu angka pun
       di sini yang belum publik.

       'batal' tidak masuk hitungan — ia tidak pernah jadi posisi, jadi
       SL-nya tidak pernah menanggung apa pun. (Gerbangnya di atas: cabang
       batal sudah keluar lewat continue sebelum sampai ke sini.) */
    {
      const slp = slPersenSinyal(a);
      if (slp !== null) {
        p.slJumlah += slp; p.slN++;
        if (slp > p.slMaks) p.slMaks = slp;
        if (slp > batasSl(a)) p.pelanggaran++;
      }
    }

    if (a.hasil === 'tp') p.menang++; else p.kalah++;
    p.hasilDolar += dolar;
    p.terakhir = Math.max(p.terakhir, a.waktuHasil || a.dibuat);

    // Kunci tanggal LOKAL server, bukan toISOString(): toISOString memakai
    // UTC, jadi hasil pukul 01:00 WIB jatuh ke tanggal kemarin dan seluruh
    // kalender bergeser satu hari.
    const t = new Date(a.waktuHasil || a.dibuat);
    const hari = t.getFullYear() + '-' + String(t.getMonth() + 1).padStart(2, '0')
               + '-' + String(t.getDate()).padStart(2, '0');
    p.harian[hari] = (p.harian[hari] || 0) + dolar;
  }

  const analis = [...peta.values()].map((p) => ({
    ...p,
    total: p.menang + p.kalah,
    /* Winrate dihitung dari yang BENAR-BENAR jalan saja. Memasukkan
       pembatalan ke penyebut akan menghukum analis yang disiplin menarik
       rencana yang sudah tidak sah — persis kebiasaan yang seharusnya
       dihargai. Jumlah pembatalannya tetap ditampilkan di sebelahnya. */
    winrate: p.menang + p.kalah ? (p.menang / (p.menang + p.kalah)) * 100 : 0,
    hasilDolar: Math.round(p.hasilDolar * 100) / 100,
    /* null, BUKAN 0, kalau tidak ada satu pun yang bisa diukur. Nol di
       kolom "jarak SL" terbaca sebagai "tanpa SL" — kebalikan dari
       "belum diketahui". */
    slPersen: p.slN ? Math.round((p.slJumlah / p.slN) * 100) / 100 : null,
    ...(() => {
      const total = p.menang + p.kalah;
      const ddPersen = Math.round(drawdownSatuan(p.harian, risiko) * RISIKO_PERSEN * 100) / 100;
      const denda = Math.min(DENDA_PER_PELANGGARAN * (pelanggaranLalu.get(p.uid) || 0), DENDA_MAKS);
      const minSinyal = MIN_SINYAL_PAPAN + denda;

      /* SEMUA sebab dikumpulkan, bukan yang pertama saja. Analis yang
         memperbaiki satu hal lalu tetap tidak masuk — tanpa diberi tahu
         masih ada yang kedua — akan menyimpulkan papannya yang rusak. */
      const sebab = [];
      if (total < minSinyal) {
        sebab.push('butuh ' + minSinyal + ' sinyal selesai bulan ini, baru ' + total
          + (denda ? ' (naik dari ' + MIN_SINYAL_PAPAN + ' karena ' + (pelanggaranLalu.get(p.uid) || 0) + ' pelanggaran bulan lalu)' : ''));
      }
      /* Sepi lebih dari 30 hari. HANYA untuk bulan berjalan: papan bulan
         lalu dilihat orang berbulan-bulan kemudian, dan mengukurnya
         dengan "hari ini" akan menyatakan semua orang tidak aktif —
         termasuk yang waktu itu rajin. */
      if (periode === kunciBulan(Date.now())) {
        const t = terakhirPosting.get(p.uid) || 0;
        const sepiHari = t ? Math.floor((Date.now() - t) / 86400000) : null;
        if (sepiHari === null || sepiHari > SEPI_MAKS_HARI) {
          sebab.push(sepiHari === null
            ? 'belum pernah memposting sinyal'
            : 'tidak memposting sinyal ' + sepiHari + ' hari (batas ' + SEPI_MAKS_HARI + ' hari)');
        }
      }
      if (ddPersen > DD_MAKS_PERSEN) {
        sebab.push('drawdown ' + ddPersen + '% melewati batas ' + DD_MAKS_PERSEN + '%');
      }
      if (p.pelanggaran > 0) {
        /* Batasnya tidak disebut di sini: satu analis bisa punya sinyal di
           dua pasar dengan batas berbeda, dan menyebut salah satunya akan
           menuduh dengan angka yang keliru. Batas lengkapnya ada di panel
           "Syarat masuk papan". */
        sebab.push(p.pelanggaran + ' sinyal jarak SL-nya di atas ' + SL_MAKS_PERSEN
          + '% (terjauh ' + (Math.round(p.slMaks * 100) / 100) + '%)');
      }
      return {
        ddPersen,
        slMaks: p.slN ? Math.round(p.slMaks * 100) / 100 : null,
        pelanggaran: p.pelanggaran,
        pelanggaranLalu: pelanggaranLalu.get(p.uid) || 0,
        minSinyal,
        layak: sebab.length === 0,
        sebabTidakLayak: sebab,
      };
    })(),
  })).sort((x, y) => (y.layak ? 1 : 0) - (x.layak ? 1 : 0) || y.hasilDolar - x.hasilDolar);

  res.json({
    ok: true, modal: MODAL_ESTIMASI, risikoPersen: RISIKO_PERSEN,
    periode, periodeLalu,
    /* Angkanya dikirim, TIDAK ditulis ulang di layar. Aturan yang ditulis
       di dua tempat suatu hari berbeda, dan yang berbeda di sini adalah
       syarat yang menentukan siapa muncul di papan. */
    aturan: {
      ddMaksPersen: DD_MAKS_PERSEN,
      slMaksPersen: SL_MAKS_PERSEN,
      slMaksTf: SL_MAKS_TF,
      slAturanMulai: SL_ATURAN_MULAI,
      sepiMaksHari: SEPI_MAKS_HARI,
      minSinyal: MIN_SINYAL_PAPAN,
      dendaPerPelanggaran: DENDA_PER_PELANGGARAN,
      dendaMaks: DENDA_MAKS,
    },
    analis,
    // Berapa sinyal yang MASIH BERJALAN — supaya layar bisa mengatakan
    // "peringkat ini belum berarti apa-apa" saat datanya masih sedikit,
    // alih-alih menampilkan winrate 100% dari satu sinyal seolah prestasi.
    berjalan: d.daftar.filter((a) => !a.hasil).length,
  });
});

app.get('/api/analisa/isi', batasLaju, butuhLogin, (req, res) => {
  const d = analisaBaca();
  const a = d.daftar.find(x => x.id === String(req.query.id || ''));
  if (!a) return res.status(404).json({ error: 'Analisa tidak ditemukan' });
  /* ── SINYAL YANG SUDAH SELESAI TERBUKA GRATIS ─────────────────────────
     Keputusan pemilik 17 Agu 2026.

     Yang dijual sinyal ini adalah PELUANG: level entry yang harganya belum
     datang. Begitu harganya menyentuh TP atau SL, peluang itu habis — yang
     tersisa cuma catatan sejarah. Menguncinya setelah itu bukan melindungi
     nilai apa pun, ia cuma menyembunyikan rekam jejak dari orang yang
     sedang menimbang apakah analisnya layak diikuti.

     Membukanya justru bekerja ke arah sebaliknya: papan peringkat sudah
     menghitung menang/kalah tiap analis, dan sekarang siapa pun bisa
     MEMERIKSA angka itu sampai ke levelnya. Klaim yang bisa diperiksa
     lebih berharga daripada level lama yang disandera.

     'batal' ikut dibuka: rencana yang ditarik penulisnya sebelum harganya
     datang juga tidak bisa ditradingkan lagi, dan alasan pembatalannya
     justru bagian yang paling layak dinilai orang.

     Yang TIDAK berubah: sinyal yang masih menunggu harga atau sedang
     berjalan tetap terkunci. Di situlah nilainya masih ada. */
  const sudahSelesai = a.hasil === 'tp' || a.hasil === 'sl' || a.hasil === 'batal';
  const boleh = a.uid === req.uid || a.harga === 0 || sudahSelesai
             || (a.pembeli || []).includes(req.uid);
  if (!boleh) return res.status(403).json({ error: 'Terkunci - kirim permintaan akses dulu', kode: 'KUNCI' });
  res.json({ ok: true, isi: a.isi, galeri: a.galeri || [] });
});

