/* Kunci bulan LOKAL server (WIB), bukan UTC. Sama alasannya dengan kunci
   harian di kalender: hasil pukul 01:00 WIB tanggal 1 akan jatuh ke bulan
   sebelumnya kalau dihitung UTC, dan seluruh papan bergeser sebulan. */
function kunciBulan(t) {
  const x = new Date(t);
  return x.getFullYear() + '-' + String(x.getMonth() + 1).padStart(2, '0');
}
function bulanSebelum(kunci) {
  const [y, m] = String(kunci).split('-').map(Number);
  const d = new Date(y, m - 2, 1);
  return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
}
/* Jarak SL sebuah sinyal sebagai persen harga, atau null kalau tidak bisa
   dihitung. Satu tempat saja — dipakai penilaian pelanggaran DAN rata-rata
   di kartu, dan dua rumus untuk satu hal yang sama selalu berselisih. */
/* Penurunan terdalam dari deret hasil harian, dalam SATUAN RISIKO.
 *  Satu satuan = uang yang dipertaruhkan per sinyal menurut model papan.
 *
 *  Rumusnya SENGAJA sama persis dengan drawdownSatuan di
 *  src/lib/ringkas-kanal.ts. Duplikasi disadari, dan alternatifnya lebih
 *  buruk: klien memakainya untuk melabeli tingkat risiko di kartu, server
 *  memakainya untuk memutuskan siapa masuk papan. Kalau keduanya
 *  berselisih, kartu akan menulis "Risiko rendah" untuk analis yang
 *  ditolak papan karena drawdown — dan tidak ada yang berbunyi seperti
 *  galat. Kalau salah satunya diubah, yang lain WAJIB ikut. */
function drawdownSatuan(harian, risikoPerSinyal) {
  if (!(risikoPerSinyal > 0)) return 0;
  const hari = Object.keys(harian || {}).sort();
  let puncak = 0, kumulatif = 0, terdalam = 0;
  for (const h of hari) {
    kumulatif += Number(harian[h]) || 0;
    puncak = Math.max(puncak, kumulatif);
    terdalam = Math.max(terdalam, puncak - kumulatif);
  }
  return terdalam / risikoPerSinyal;
}
function slPersenSinyal(a) {
  const e = Number((a.isi || {}).entry) || 0;
  const x = Number((a.isi || {}).sl) || 0;
  if (!(e > 0) || !(x > 0)) return null;
  return (Math.abs(e - x) / e) * 100;
}

app.get('/api/analisa/performa', batasLaju, (req, res) => {
