// ── FALLBACK_SPA — alamat bersih, tanpa tanda pagar ─────────────────────
// Sebelum ini aplikasinya memakai HashRouter (/#/dashboard) sehingga
// seluruh rutenya hidup sesudah tanda pagar dan tidak pernah sampai ke
// server. Akibatnya Google cuma melihat SATU alamat untuk seluruh situs:
// segala sesuatu sesudah "#" tidak pernah dikirim peramban.
//
// Sekarang rutenya alamat sungguhan, jadi /dashboard benar-benar tiba di
// sini dan harus dijawab index.html — kalau tidak, situsnya 404 begitu
// ada yang me-refresh halaman selain beranda.
//
// TIGA PENJAGA, dan yang ketiga yang paling penting:
//
//  1. Awalan yang sudah punya pemilik dilewatkan apa adanya.
//
//  2. Permintaan yang tidak meminta HTML dilewatkan. fetch() dan XHR
//     harus tetap menerima 404 yang jujur; memulangkan halaman kepada
//     pemanggil yang menunggu JSON menghasilkan galat parse yang
//     menunjuk ke tempat yang salah.
//
//  3. Apa pun yang berakhiran ekstensi berkas dilewatkan. Nama potongan
//     JavaScript berubah tiap rilis; kalau /assets/index-LAMA.js dijawab
//     index.html, peramban menerima HTML lalu mencoba menjalankannya
//     sebagai JavaScript. Hasilnya layar putih tanpa satu pun pesan yang
//     menunjuk penyebabnya. Berkas yang hilang HARUS 404 dengan berisik.
app.use(function (req, res, next) {
  if (req.method !== "GET" && req.method !== "HEAD") return next();
  if (/^\/(api|gambar|v2|v3|__)(\/|$)/.test(req.path)) return next();
  // Googlebot mengirim Accept: */* — BUKAN Accept ala peramban. Versi
  // pertama baris ini mensyaratkan "text/html" dan akibatnya menjawab 404
  // kepada perayap Google di setiap halaman; Live Test memulangkan
  // "Page fetch: Failed: Not found (404)" sementara curl dari mesin yang
  // sama memulangkan 200. Jadi yang ditolak sekarang hanya pemanggil yang
  // JELAS meminta sesuatu selain HTML (fetch dengan Accept: application/
  // json), bukan semua yang tidak menyebut text/html.
  var terima = String(req.headers.accept || "");
  if (terima && terima.indexOf("text/html") === -1 && terima.indexOf("*/*") === -1) return next();
  if (/\.[a-zA-Z0-9]+$/.test(req.path)) return next();
  res.setHeader("Cache-Control", "no-cache");
  res.type("html").send(halamanUntuk(req.path));
});

// ── KEPALA_PER_HALAMAN ─────────────────────────────────────────────────
// Judul, deskripsi, dan canonical yang berbeda untuk tiap alamat publik.
//
// Tanpa ini seluruh halaman memakai kepala yang sama, termasuk
//     <link rel="canonical" href="https://jaditrader.co.id/">
// yang artinya setiap halaman menyatakan halaman depan sebagai versi
// resminya. Halaman yang menunjuk halaman lain sebagai kanoniknya tidak
// akan pernah diindeks sendiri — Search Console menolak permintaan indeks
// untuk /preview persis karena ini.
//
// Yang tidak terdaftar di bawah memakai kepala bawaan index.html. Itu
// disengaja: halaman di balik login tidak perlu dibedakan, dan menuliskan
// judul untuk halaman yang tidak bisa dibuka siapa pun cuma menambah
// baris yang harus dirawat.
const KEPALA = {
  "/": null,   // pakai bawaan index.html
  "/preview": {
    judul: "Pratinjau Jadi Trader Tools — coba tanpa daftar",
    ket: "Lihat isi terminalnya sebelum membuat akun: chart replay, screener multi-pair, jurnal otomatis, dan papan sinyal. Seluruh angkanya data contoh."
  },
