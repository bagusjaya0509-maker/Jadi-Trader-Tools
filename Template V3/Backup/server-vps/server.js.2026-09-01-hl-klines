/* ── PERMINTAAN LISENSI ────────────────────────────────────────────────────
   Sampai sekarang satu-satunya jalur adalah pemilik mengetik kode lalu
   mengaktifkannya. Pembelinya sendiri tidak punya cara memberi tahu bahwa ia
   sudah membayar — jalurnya lewat WhatsApp, dan yang lewat WhatsApp gampang
   terlewat.

   Tiga rute di bawah menutup lingkaran itu: pembeli mengirim permintaan,
   pemilik melihatnya di panel Maintenance, lalu menyetujui — dan penyetujuan
   itulah yang MENERBITKAN kodenya. Tidak ada langkah manual di antaranya
   yang bisa lupa dikerjakan.

   Emailnya diambil dari ID TOKEN yang sudah diverifikasi, bukan dari kiriman
   halaman. Tanpa itu siapa pun bisa mengirim permintaan atas nama orang lain,
   dan daftar yang harus dipercaya pemilik justru jadi tidak bisa dipercaya. */

function lisensiPermintaan(d) {
  if (!Array.isArray(d.permintaan)) d.permintaan = [];
  return d.permintaan;
}

/* Kode JT3-XXXX-XXXX-XXXX. Huruf yang mudah tertukar (I, O, 0, 1) dibuang:
   kode ini dibacakan lewat telepon dan disalin tangan, dan satu karakter
   salah berarti pembeli mengira lisensinya tidak aktif. */
function buatKodeLisensi() {
  const HURUF = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  const blok = () => Array.from({ length: 4 }, () =>
    HURUF[crypto.randomBytes(1)[0] % HURUF.length]).join('');
  return `JT3-${blok()}-${blok()}-${blok()}`;
}

// --- Pembeli: kirim permintaan aktivasi ---
app.post('/api/lisensi/minta', batasLaju, butuhLogin, async (req, res) => {
  const h = String(req.headers.authorization || '');
  let email = '', nama = '';
  try {
    const v = await verifikasiIdToken(h.slice(7));
    email = v.email || '';
    nama = v.name || '';
  } catch (e) {}

  const b = req.body || {};
  const d = lisensiBaca();
  const daftar = lisensiPermintaan(d);

  /* Satu permintaan terbuka per orang per produk. Tanpa penjaga ini, tombol
     yang ditekan berkali-kali karena dikira tidak jalan akan membanjiri panel
     pemilik dengan baris yang sama. */
  const produk = String(b.produk || 'jadi-trader-v3').slice(0, 60);
  const sudah = daftar.find(x => x.uid === req.uid && x.produk === produk && x.status === 'baru');
  if (sudah) return res.json({ ok: true, sudahAda: true, id: sudah.id });

  /* Harga yang berlaku dicatat DI BARIS PERMINTAANNYA, ditentukan server.
     Dua gunanya: pemilik melihat angka yang benar saat menyetujui, dan
     kalau harganya berubah bulan depan, baris lama tetap menyimpan angka
     yang berlaku saat itu — bukan angka hari ini. */
  const stHarga = bacaSetelan(d);
  const promoSudah = promoTerpakai(d, req.uid);

  /* Jenis ditentukan di SINI, bukan diterima apa adanya dari browser.
     Kalau kuota gratisnya sudah habis, permintaan yang mengaku gratis tetap
     jadi berbayar — kalau tidak, siapa pun bisa mengirim {jenis:'gratis'}
     lewat curl dan melewati batas 20 itu. */
  const kuota = hitungKuota(d);
  if (!kuota.bukaPermintaan) {
    return res.status(403).json({ error: 'Pendaftaran akses sedang ditutup.' });
  }
  let jenis = b.jenis === 'bayar' ? 'bayar' : 'gratis';
  if (jenis === 'gratis' && kuota.gratisHabis) jenis = 'bayar';
  if (jenis === 'bayar' && kuota.bayarHabis) {
    return res.status(409).json({ error: 'Kuota akses sudah penuh untuk saat ini.' });
  }

  const item = {
    id: 'R' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6),
    uid: req.uid,
    jenis,
    email,
    nama: String(b.nama || nama || '').slice(0, 80),
    produk,
    catatan: String(b.catatan || '').slice(0, 300),
    bukti: String(b.bukti || '').slice(0, 300),
    status: 'baru',
    waktu: Date.now(),
    promo: jenis === 'bayar' ? !promoSudah : false,
    hargaSaat: jenis === 'bayar'
      ? (promoSudah ? stHarga.hargaTestingCoret : stHarga.hargaTesting)
      : 0
  };
  daftar.unshift(item);
  if (daftar.length > 500) daftar.length = 500;
  lisensiTulis(d);
  res.json({ ok: true, id: item.id });

  /* SESUDAH res.json, dan TANPA await yang menahannya. Permintaannya sudah
     tercatat; kalau Resend lambat atau menolak, yang hilang cuma kabarnya —
     bukan pendaftaran orang itu. Ini aturan yang sama dengan surat
     persetujuan, dan alasannya sama. */
  kirimSuratPermintaanMasuk({
    email: item.email, nama: item.nama, produk: item.produk,
    jenis: item.jenis, bukti: item.bukti, catatan: item.catatan,
  }).catch((e) => console.error('[surel] pemberitahuan permintaan gagal:', e && e.message));
});

/* --- Pengguna: TUKAR KODE LISENSI JADI AKSES ---
   ────────────────────────────────────────────────────────────────────────
   Inilah satu-satunya cara akses terbuka sekarang. Sebelumnya gerbangnya
   bergantung pada masa coba dan penanda "akun lama", dan keduanya bocor:
   siapa pun yang pernah login sekali sudah punya masa coba, jadi gerbangnya
   membuka untuk orang yang tidak pernah disetujui siapa pun.

   Kode diikat ke UID pertama yang menukarnya. Tanpa pengikatan itu satu kode
   bisa disebar ke seratus orang dan kuota 20/80 tidak berarti apa-apa. */
app.post('/api/akses/aktifkan', batasLaju, butuhLogin, async (req, res) => {
  const kode = String((req.body || {}).kode || '').trim().toUpperCase();
  if (!/^JT3-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}$/.test(kode)) {
    return res.status(400).json({ error: 'Format kode tidak sesuai. Contoh: JT3-A1B2-C3D4-E5F6' });
  }
  const sidik = sidikDari(kode);
  const d = lisensiBaca();
  const baris = (d.aktif || []).find(x => x.sidik === sidik);
  if (!baris) return res.status(404).json({ error: 'Kode tidak dikenal atau sudah dicabut.' });

  if (baris.uid && baris.uid !== req.uid) {
    return res.status(409).json({ error: 'Kode ini sudah dipakai akun lain.' });
  }

  if (!baris.uid) {
    baris.uid = req.uid;
    baris.berakhir = Date.now() + AKSES_HARI * MS_HARI;
    baris.ditukarPada = Date.now();
    lisensiTulis(d);
  }

  let firestoreOk = false;
  try {
    const admin = ambilAdmin();
    if (admin) {
      await admin.firestore().collection('langganan').doc(req.uid).set({
        bayarSampai: admin.firestore.Timestamp.fromMillis(baris.berakhir),
        sidikLisensi: sidik,
        produk: baris.produk || 'jadi-trader-v3'
      }, { merge: true });
      firestoreOk = true;
    }
  } catch (e) { console.error('Gagal menulis langganan:', e.message); }

  res.json({ ok: true, berakhir: baris.berakhir, produk: baris.produk || '', firestoreOk });
});

